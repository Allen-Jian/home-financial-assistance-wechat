.period-switch { display: flex; gap: 12rpx; }.period-switch button { flex: 1; height: 64rpx; line-height: 64rpx; border-radius: 16rpx; color: var(--color-muted); background: var(--color-tint); font-size: 24rpx; }.period-switch .active { color: var(--color-on-primary); background: var(--color-primary); }
