.transaction-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }.transaction-row > view { min-width: 0; flex: 1; }.merchant, .date { display: block; overflow-wrap: anywhere; }.merchant { color: var(--color-text-secondary); font-size: 28rpx; }.date { margin-top: 6rpx; color: var(--color-muted); font-size: 24rpx; }.amount { flex: none; color: var(--color-income); font-size: 29rpx; font-weight: 700; font-variant-numeric: tabular-nums; }.amount.expense { color: var(--color-expense); }
