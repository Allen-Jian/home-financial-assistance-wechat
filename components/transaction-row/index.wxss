.transaction-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--color-line); }.merchant, .date { display: block; }.merchant { color: var(--color-text-secondary); font-size: 26rpx; }.date { margin-top: 6rpx; color: var(--color-muted); font-size: 22rpx; }.amount { color: var(--color-income); font-size: 28rpx; font-weight: 700; }.amount.expense { color: var(--color-expense); }
