.photo-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.picker-button { margin-top: 44rpx; padding: 28rpx; border-radius: 24rpx; }.primary-button { color: var(--color-on-primary); background: var(--color-primary); }.photo-card { margin-top: 28rpx; padding: 28rpx; border-radius: 24rpx; background: var(--color-surface); }.file-name { display: block; color: var(--color-muted); font-size: 24rpx; }.draft-overview { margin-top: 20rpx; }.draft-line { display: flex; justify-content: space-between; align-items: center; min-height: 78rpx; border-bottom: 1rpx solid var(--color-border); color: var(--color-text-secondary); font-size: 27rpx; }.draft-line input { flex: 1; margin-left: 24rpx; text-align: right; color: var(--color-text); }.confirm-button { margin-top: 28rpx; border-radius: 18rpx; }.error { display: block; margin-top: 18rpx; color: var(--color-expense); font-size: 24rpx; }.success { display: block; margin-top: 28rpx; color: var(--color-income); font-size: 30rpx; text-align: center; }
