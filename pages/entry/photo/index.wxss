.capture-page { min-height: 100vh; padding: 88rpx 32rpx 64rpx; background: var(--color-background); }.entry-appbar { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.entry-appbar > text { color: var(--color-text); font-size: 32rpx; font-weight: 600; }.close-button, .appbar-spacer { width: 88rpx; }.close-button { margin: 0; padding: 0; border-radius: 50%; color: var(--color-text); background: var(--color-surface); font-size: 40rpx; line-height: 84rpx; }
.capture-start { padding: 90rpx 12rpx 0; text-align: center; }.capture-start > text { display: block; }.capture-start > text:nth-child(2) { margin-top: 28rpx; color: var(--color-text); font-size: 34rpx; font-weight: 600; }.capture-start > text:nth-child(3) { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; }.capture-start .primary-button { width: 100%; margin-top: 38rpx; }.image-source-actions { display: flex; margin-top: 16rpx; gap: 16rpx; }.image-source-actions button { flex: 1; min-width: 0; margin: 0; padding: 0 10rpx; white-space: normal; line-height: 1.35; }.capture-illustration { position: relative; width: 150rpx; height: 114rpx; margin: auto; border: 6rpx solid var(--color-primary); border-radius: 24rpx; background: var(--color-tint); }.capture-illustration::before { content: ''; position: absolute; left: 49rpx; top: 31rpx; width: 42rpx; height: 42rpx; border: 6rpx solid var(--color-primary); border-radius: 50%; }.capture-illustration::after { content: ''; position: absolute; left: 32rpx; top: -22rpx; width: 66rpx; height: 20rpx; border: 6rpx solid var(--color-primary); border-bottom: 0; border-radius: 14rpx 14rpx 0 0; }.capture-illustration.bill { width: 106rpx; height: 138rpx; border-radius: 14rpx; }.capture-illustration.bill::before { left: 24rpx; right: 24rpx; top: 38rpx; width: auto; height: 5rpx; border: 0; border-radius: 0; background: var(--color-primary); box-shadow: 0 24rpx 0 var(--color-primary), 0 48rpx 0 var(--color-primary); }.capture-illustration.bill::after { display: none; }
.analysis-state { padding: 90rpx 10rpx 0; text-align: center; }.ai-scanner { position: relative; width: 190rpx; height: 190rpx; margin: auto; }.scan-orbit { position: absolute; inset: 0; border: 3rpx dashed var(--color-primary); border-radius: 50%; animation: orbit 3s linear infinite; }.scan-core { position: absolute; left: 48rpx; top: 34rpx; width: 94rpx; height: 122rpx; border: 5rpx solid var(--color-primary); border-radius: 18rpx; background: var(--color-surface); overflow: hidden; }.scan-core::before, .scan-core::after { content: ''; position: absolute; left: 22rpx; right: 22rpx; height: 5rpx; background: var(--color-line); }.scan-core::before { top: 34rpx; }.scan-core::after { top: 62rpx; }.scan-core view { position: absolute; z-index: 2; left: 0; right: 0; top: 10rpx; height: 5rpx; background: var(--color-accent); box-shadow: 0 0 18rpx var(--color-accent); animation: scan 1.8s ease-in-out infinite alternate; }.analysis-title, .analysis-status, .analysis-note { display: block; }.analysis-title { margin-top: 32rpx; color: var(--color-text); font-size: 34rpx; font-weight: 600; }.analysis-status { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 25rpx; }.analysis-note { margin-top: 14rpx; color: var(--color-muted); font-size: 22rpx; }.progress { height: 8rpx; margin-top: 34rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-line); }.progress view { width: 45%; height: 100%; border-radius: inherit; background: var(--color-primary); animation: progress 1.6s ease-in-out infinite alternate; }
.entry-form { padding-top: 22rpx; }.ai-filled-note { display: flex; padding: 18rpx 20rpx; align-items: center; gap: 14rpx; border-left: 7rpx solid var(--color-accent); border-radius: 18rpx; background: var(--color-accent-surface); }.ai-filled-note > text { color: var(--color-expense); font-size: 30rpx; }.ai-filled-note view { flex: 1; }.ai-filled-note view text { display: block; }.ai-filled-note view text:first-child { color: var(--color-text); font-size: 25rpx; font-weight: 600; }.ai-filled-note view text:last-child { margin-top: 3rpx; color: var(--color-muted); font-size: 22rpx; }
.direction-switch { display: flex; margin-top: 22rpx; padding: 6rpx; gap: 6rpx; border-radius: 24rpx; background: var(--color-tint); }.direction-switch button { flex: 1; min-height: 88rpx; margin: 0; padding: 0; border-radius: 18rpx; color: var(--color-muted); background: transparent; }.direction-switch .active { color: var(--color-on-primary); background: var(--color-primary); }
.amount-field { margin-top: 18rpx; padding: 22rpx 24rpx; border: 2rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.amount-field > text { display: block; color: var(--color-muted); font-size: 23rpx; }.amount-field > view { display: flex; margin-top: 8rpx; align-items: center; }.amount-field view > text { color: var(--color-primary); font-size: 32rpx; font-weight: 600; }.amount-field input { flex: 1; min-width: 0; margin-left: 14rpx; color: var(--color-text); font-size: 58rpx; font-weight: 500; }
.inline-field { display: flex; min-height: 96rpx; margin-top: 16rpx; padding: 20rpx 22rpx; align-items: center; gap: 18rpx; border: 2rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }.inline-field > text { flex: none; color: var(--color-text-secondary); font-size: 25rpx; }.inline-field input { flex: 1; min-width: 0; color: var(--color-text); text-align: right; font-size: 26rpx; }
.category-section { margin-top: 24rpx; }.category-head { display: flex; align-items: center; justify-content: space-between; }.category-head > text:first-child { color: var(--color-text); font-size: 29rpx; font-weight: 600; }.category-head > text:last-child { padding: 5rpx 12rpx; border-radius: 999rpx; color: var(--color-warning); background: var(--color-warning-surface); font-size: 20rpx; }.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 14rpx; }.category-grid button { min-width: 0; min-height: 88rpx; margin: 0; padding: 8rpx; border: 2rpx solid var(--color-line); border-radius: 20rpx; color: var(--color-text-secondary); background: var(--color-surface); font-size: 24rpx; }.category-grid .active { border-color: var(--color-accent); color: var(--color-warning); background: var(--color-accent-surface); }
.form-group { margin-top: 18rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.form-row { display: flex; min-height: 98rpx; padding: 18rpx 22rpx; align-items: center; justify-content: space-between; }.form-row view text { display: block; }.form-row view text:first-child, .note-field > text { color: var(--color-muted); font-size: 22rpx; }.form-row view text:last-child { margin-top: 3rpx; color: var(--color-text); font-size: 26rpx; }.note-field { display: block; padding: 18rpx 22rpx; border-top: 1rpx solid var(--color-line); }.note-field textarea { width: 100%; min-height: 116rpx; margin-top: 8rpx; color: var(--color-text); font-size: 26rpx; }.safety-note { display: flex; margin-top: 18rpx; padding: 18rpx 20rpx; align-items: center; gap: 12rpx; border-radius: 20rpx; color: var(--color-text-secondary); background: var(--color-tint); font-size: 22rpx; }.safety-note > text:first-child { color: var(--color-primary); font-weight: 700; }.save-button { width: 100%; margin-top: 22rpx; }.fallback-actions { margin-top: 16rpx; }.fallback-actions button { width: 100%; color: var(--color-primary); background: var(--color-tint); }
.analysis-error, .success-state { padding: 100rpx 18rpx 0; text-align: center; }.analysis-error > text { display: block; color: var(--color-expense); font-size: 26rpx; }.analysis-error button { width: 100%; margin-top: 18rpx; }.success-state text { display: block; }.success-state text:first-child { display: flex; width: 96rpx; height: 96rpx; margin: auto; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); font-size: 44rpx; }.success-state text:nth-child(2) { margin-top: 24rpx; color: var(--color-text); font-size: 34rpx; font-weight: 600; }.success-state text:last-child { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; }
@keyframes orbit { to { transform: rotate(360deg); } } @keyframes scan { from { transform: translateY(0); } to { transform: translateY(92rpx); } } @keyframes progress { from { transform: translateX(-20%); } to { transform: translateX(140%); } }
@media (prefers-reduced-motion: reduce) { .scan-orbit, .scan-core view, .progress view { animation: none; }.progress view { width: 70%; transform: none; } }
