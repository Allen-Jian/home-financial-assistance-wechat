.entry-page { min-height: 100vh; padding: 88rpx 32rpx 64rpx; background: var(--color-background); }.entry-appbar { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.entry-appbar > text { color: var(--color-text); font-size: 32rpx; font-weight: 600; }.close-button, .appbar-spacer { width: 88rpx; }.close-button { margin: 0; padding: 0; border-radius: 50%; color: var(--color-text); background: var(--color-surface); font-size: 40rpx; line-height: 84rpx; }.entry-intro { margin: 28rpx 0 32rpx; }.entry-intro text { display: block; }.entry-intro text:first-child { color: var(--color-text); font-size: 38rpx; font-weight: 600; }.entry-intro text:last-child { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; }
.method-card { display: flex; width: 100%; min-height: 132rpx; margin: 16rpx 0 0; padding: 22rpx 20rpx; align-items: center; gap: 18rpx; border: 1rpx solid var(--color-line); border-radius: 30rpx; background: var(--color-surface); text-align: left; }.method-card.primary-method { min-height: 154rpx; border-color: transparent; background: var(--color-accent-surface); }.method-card > view:nth-child(2) { flex: 1; min-width: 0; }.method-card text { display: block; }.method-card > view:nth-child(2) text:first-child { color: var(--color-text); font-size: 29rpx; font-weight: 600; }.method-card > view:nth-child(2) text:last-child { margin-top: 7rpx; color: var(--color-muted); font-size: 23rpx; white-space: normal; }.method-icon { position: relative; flex: none; width: 62rpx; height: 62rpx; border-radius: 20rpx; color: var(--color-primary); background: var(--color-tint); }.camera-icon::before { content: ''; position: absolute; left: 14rpx; top: 20rpx; width: 30rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }.camera-icon::after { content: ''; position: absolute; left: 25rpx; top: 25rpx; width: 8rpx; height: 8rpx; border: 3rpx solid currentColor; border-radius: 50%; }.pencil-icon::before { content: ''; position: absolute; left: 15rpx; top: 29rpx; width: 34rpx; height: 7rpx; border: 3rpx solid currentColor; border-radius: 4rpx; transform: rotate(-45deg); }.file-icon::before { content: ''; position: absolute; left: 18rpx; top: 12rpx; width: 25rpx; height: 35rpx; border: 3rpx solid currentColor; border-radius: 5rpx; }.file-icon::after { content: ''; position: absolute; left: 25rpx; top: 26rpx; width: 14rpx; height: 3rpx; background: currentColor; box-shadow: 0 9rpx 0 currentColor; }.chevron { flex: none; color: var(--color-primary); font-size: 40rpx; }.safety-note { display: flex; margin-top: 26rpx; padding: 20rpx; align-items: center; gap: 14rpx; border-radius: 24rpx; color: var(--color-text-secondary); background: var(--color-tint); font-size: 23rpx; }.shield-icon { display: flex; flex: none; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; border: 3rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); font-size: 20rpx; }
