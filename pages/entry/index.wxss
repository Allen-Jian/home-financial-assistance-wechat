.entry-page { min-height: 100vh; padding: 40rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }
.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }
.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.entry-card { display: flex; align-items: center; margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 26rpx; background: var(--color-surface); box-shadow: 0 10rpx 28rpx var(--shadow-primary); }
.photo-card { margin-top: 44rpx; background: var(--color-tint); }
.entry-icon { width: 72rpx; font-size: 42rpx; text-align: center; }
.entry-copy { flex: 1; margin-left: 22rpx; }
.entry-title, .entry-detail { display: block; }
.entry-title { color: var(--color-text); font-size: 30rpx; font-weight: 700; }
.entry-detail { margin-top: 10rpx; color: var(--color-muted); font-size: 23rpx; }
.entry-arrow { color: var(--color-primary); font-size: 42rpx; }
