<view class="page entry-page">
  <view class="page-title"><text>记一笔</text><text class="sub">选择适合你的记录方式</text></view>
  <view class="entry-card photo-card" bindtap="openPhoto">
    <text class="entry-icon">📷</text>
    <view class="entry-copy"><text class="entry-title">拍照记账</text><text class="entry-detail">拍照，AI 帮你生成草稿</text></view>
    <text class="entry-arrow">›</text>
  </view>
  <view class="entry-card manual-card" bindtap="openManual">
    <text class="entry-icon">✍️</text>
    <view class="entry-copy"><text class="entry-title">手动记账</text><text class="entry-detail">填写收入或支出、金额、分类和备注</text></view>
    <text class="entry-arrow">›</text>
  </view>
</view>
