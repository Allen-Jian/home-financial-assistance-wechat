<view class="page drafts-page">
  <view class="page-title"><text>待确认草稿</text><text class="sub">人工确认后才会影响余额</text></view>
  <view wx:if="{{current}}" class="progress">{{index + 1}} / {{drafts.length}}</view>
  <view wx:if="{{current}}" class="review-card"><text class="source">{{current.rawPayload.sourceFileName || '手工/AI 草稿'}}</text><view class="review-line"><text>商户</text><text>{{current.merchant || '未识别'}}</text></view><view class="review-line"><text>金额</text><text>NZ$ {{current.amountMinor / 100}}</text></view><view class="review-line"><text>日期</text><text>{{current.occurredAt || '未识别'}}</text></view><picker bindchange="onAccountChange" mode="selector" range="{{accounts}}" range-key="name"><view class="account-picker">{{accountName || '选择入账账户'}}</view></picker><button class="edit-button" bindtap="onEdit">修改草稿</button></view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view wx:if="{{duplicateActions.length}}" class="duplicate-actions"><button bindtap="later">稍后处理</button><button class="primary-button" bindtap="keepBoth">保留两笔</button></view>
  <button wx:if="{{current && !duplicateActions.length}}" class="primary-button" loading="{{loading}}" bindtap="confirm">确认入账</button>
  <view wx:if="{{!current && !loading}}" class="empty">没有待确认草稿</view>
</view>
