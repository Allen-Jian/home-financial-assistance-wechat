.drafts-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.progress { margin-top: 28rpx; color: var(--color-primary); font-size: 24rpx; }.review-card { margin-top: 16rpx; padding: 28rpx; border-radius: 24rpx; background: var(--color-surface); }.source { display: block; margin-bottom: 18rpx; color: var(--color-text); font-size: 28rpx; font-weight: 700; }.review-line { display: flex; justify-content: space-between; padding: 18rpx 0; color: var(--color-text-secondary); border-bottom: 1rpx solid var(--color-line); font-size: 26rpx; }.account-picker { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; color: var(--color-primary); background: var(--color-tint); }.edit-button { margin-top: 18rpx; color: var(--color-primary); background: var(--color-surface); border: 1rpx solid var(--color-line); font-size: 24rpx; }.primary-button { margin-top: 24rpx; color: var(--color-on-primary); background: var(--color-primary); }.duplicate-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }.duplicate-actions button { flex: 1; font-size: 24rpx; }.error { display: block; margin-top: 18rpx; color: var(--color-expense); font-size: 24rpx; }.empty { padding-top: 120rpx; color: var(--color-muted); text-align: center; font-size: 28rpx; }
