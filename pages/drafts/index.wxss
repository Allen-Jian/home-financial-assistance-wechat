.drafts-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.progress { margin-top: 28rpx; color: #127c73; font-size: 24rpx; }.review-card { margin-top: 16rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }.source { display: block; margin-bottom: 18rpx; color: #123b38; font-size: 28rpx; font-weight: 700; }.review-line { display: flex; justify-content: space-between; padding: 18rpx 0; color: #3d5753; border-bottom: 1rpx solid #e2efeb; font-size: 26rpx; }.account-picker { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; color: #127c73; background: #e8f3ef; }.edit-button { margin-top: 18rpx; color: #127c73; background: #fff; border: 1rpx solid #b9d9d2; font-size: 24rpx; }.primary-button { margin-top: 24rpx; color: #fff; background: #127c73; }.duplicate-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }.duplicate-actions button { flex: 1; font-size: 24rpx; }.error { display: block; margin-top: 18rpx; color: #c54545; font-size: 24rpx; }.empty { padding-top: 120rpx; color: #78918d; text-align: center; font-size: 28rpx; }
