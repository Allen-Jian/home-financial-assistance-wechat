.imports-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.action-grid { display: flex; gap: 16rpx; margin-top: 36rpx; }.action-grid button { flex: 1; padding: 22rpx 0; border-radius: 20rpx; color: var(--color-primary); background: var(--color-tint); font-size: 26rpx; }.file-card, .preview-card { margin-top: 22rpx; padding: 26rpx; border-radius: 22rpx; background: var(--color-surface); }.file-name, .file-meta, .preserved { display: block; }.file-name { color: var(--color-text); font-size: 28rpx; font-weight: 700; }.file-meta { margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }.preserved { margin-top: 12rpx; color: var(--color-primary); font-size: 22rpx; }.preview-line { display: flex; justify-content: space-between; padding: 14rpx 0; color: var(--color-text-secondary); font-size: 25rpx; border-bottom: 1rpx solid var(--color-line); }.confidence { display: block; margin-top: 14rpx; color: var(--color-warning); font-size: 22rpx; }.section-title { color: var(--color-text); font-size: 27rpx; font-weight: 700; }.error { display: block; margin-top: 18rpx; color: var(--color-expense); font-size: 24rpx; }.primary-button { margin-top: 28rpx; color: var(--color-on-primary); background: var(--color-primary); }
