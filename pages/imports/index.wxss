.imports-page { min-height: 100vh; padding: 30rpx 32rpx 64rpx; background: var(--color-background); }.imports-header text { display: block; }.imports-header text:first-child { color: var(--color-text); font-size: 40rpx; font-weight: 600; }.imports-header text:last-child { margin-top: 6rpx; color: var(--color-muted); font-size: 24rpx; }
.statement-intro { margin-top: 38rpx; }.statement-intro text { display: block; }.statement-intro text:first-child { color: var(--color-text); font-size: 33rpx; font-weight: 600; }.statement-intro text:last-child { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }.upload-card { display: flex; width: 100%; min-height: 260rpx; margin-top: 24rpx; padding: 34rpx 20rpx; flex-direction: column; align-items: center; justify-content: center; border: 3rpx dashed var(--color-line); border-radius: 32rpx; background: var(--color-surface); }.upload-card > text { display: block; }.upload-card > text:nth-child(2) { margin-top: 20rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }.upload-card > text:last-child { margin-top: 6rpx; color: var(--color-muted); font-size: 23rpx; }.upload-file-icon { position: relative; width: 70rpx; height: 84rpx; border: 5rpx solid var(--color-primary); border-radius: 12rpx; }.upload-file-icon::before { content: '↑'; position: absolute; left: 13rpx; top: 8rpx; color: var(--color-primary); font-size: 42rpx; }.csv-button { width: 100%; margin-top: 14rpx; }.safety-note, .matched-note { display: flex; margin-top: 22rpx; padding: 18rpx 20rpx; align-items: center; gap: 12rpx; border-radius: 22rpx; color: var(--color-text-secondary); background: var(--color-tint); font-size: 23rpx; }.safety-note text:first-child, .matched-note text:first-child { color: var(--color-primary); font-weight: 700; }
.analysis-state { padding: 90rpx 10rpx 0; text-align: center; }.ai-scanner { position: relative; width: 190rpx; height: 190rpx; margin: auto; }.scan-orbit { position: absolute; inset: 0; border: 3rpx dashed var(--color-primary); border-radius: 50%; animation: orbit 3s linear infinite; }.sheet-core { position: absolute; left: 48rpx; top: 34rpx; width: 94rpx; height: 122rpx; border: 5rpx solid var(--color-primary); border-radius: 18rpx; background: var(--color-surface); overflow: hidden; }.sheet-core::before { content: ''; position: absolute; inset: 26rpx 16rpx; background: repeating-linear-gradient(to bottom, var(--color-line) 0 4rpx, transparent 4rpx 18rpx); }.sheet-core view { position: absolute; z-index: 2; left: 0; right: 0; top: 10rpx; height: 5rpx; background: var(--color-accent); box-shadow: 0 0 18rpx var(--color-accent); animation: scan 1.8s ease-in-out infinite alternate; }.analysis-title, .analysis-status, .analysis-note { display: block; }.analysis-title { margin-top: 32rpx; color: var(--color-text); font-size: 34rpx; font-weight: 600; }.analysis-status { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 25rpx; }.analysis-note { margin-top: 14rpx; color: var(--color-muted); font-size: 22rpx; }.progress { height: 8rpx; margin-top: 34rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-line); }.progress view { width: 45%; height: 100%; border-radius: inherit; background: var(--color-primary); animation: progress 1.6s ease-in-out infinite alternate; }
.reconcile-results { padding-top: 26rpx; }.reconcile-done { display: flex; align-items: center; gap: 16rpx; }.reconcile-done > text { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); font-size: 26rpx; }.reconcile-done view text { display: block; }.reconcile-done view text:first-child { color: var(--color-text); font-size: 30rpx; font-weight: 600; }.reconcile-done view text:last-child { margin-top: 3rpx; color: var(--color-muted); font-size: 22rpx; }.reconcile-counts { display: flex; margin-top: 22rpx; padding: 20rpx 10rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.reconcile-counts view { flex: 1; text-align: center; }.reconcile-counts view + view { border-left: 1rpx solid var(--color-line); }.reconcile-counts text { display: block; }.reconcile-counts text:first-child { color: var(--color-text); font-size: 32rpx; font-weight: 600; }.reconcile-counts text:last-child { margin-top: 3rpx; color: var(--color-muted); font-size: 21rpx; }
.result-section { margin-top: 28rpx; }.result-head { display: flex; align-items: center; justify-content: space-between; }.result-head text:first-child { color: var(--color-text); font-size: 29rpx; font-weight: 600; }.result-head text:last-child { color: var(--color-muted); font-size: 21rpx; }.missing-row, .duplicate-row { margin-top: 12rpx; padding: 20rpx; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }.missing-row { display: flex; min-height: 92rpx; align-items: center; gap: 12rpx; box-sizing: border-box; }.missing-row checkbox { flex: none; transform: scale(.86); }.missing-row > view { flex: 1; min-width: 0; }.missing-row view text, .duplicate-row > view > text { display: block; }.missing-row view text:first-child, .duplicate-row > view > text:first-child { color: var(--color-text); font-size: 26rpx; font-weight: 500; }.missing-row view text:last-child, .duplicate-row > view > text:last-child { margin-top: 4rpx; color: var(--color-muted); font-size: 22rpx; }.amount { flex: none; max-width: 34%; color: var(--color-income); font-size: 24rpx; font-weight: 600; text-align: right; overflow-wrap: anywhere; }.amount.expense { color: var(--color-expense); }.duplicate-actions { display: flex; margin-top: 14rpx; gap: 12rpx; }.duplicate-actions button { flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 8rpx; border-radius: 18rpx; color: var(--color-primary); background: var(--color-tint); font-size: 23rpx; }.resolution, .success-copy { display: block; margin-top: 10rpx; color: var(--color-primary); font-size: 22rpx; }.confirm-button { width: 100%; margin-top: 22rpx; }
.action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 30rpx; }.action-grid button { display: flex; min-width: 0; min-height: 100rpx; margin: 0; padding: 16rpx; align-items: center; justify-content: center; gap: 12rpx; border-radius: 24rpx; color: var(--color-text); background: var(--color-tint); font-size: 25rpx; }.mini-icon { position: relative; width: 34rpx; height: 34rpx; color: var(--color-primary); }.mini-icon.file, .mini-icon.sheet { border: 3rpx solid currentColor; border-radius: 5rpx; }.mini-icon.camera { border: 3rpx solid currentColor; border-radius: 6rpx; }.mini-icon.camera::after { content: ''; position: absolute; left: 9rpx; top: 7rpx; width: 9rpx; height: 9rpx; border: 3rpx solid currentColor; border-radius: 50%; }.mini-icon.image { border: 3rpx solid currentColor; border-radius: 6rpx; }.mini-icon.image::after { content: ''; position: absolute; left: 4rpx; right: 4rpx; bottom: 5rpx; height: 12rpx; background: currentColor; clip-path: polygon(0 100%, 38% 20%, 58% 70%, 76% 38%, 100% 100%); }.text-entry { display: flex; min-height: 92rpx; margin-top: 16rpx; padding-left: 18rpx; border: 2rpx solid var(--color-line); border-radius: 22rpx; background: var(--color-surface); }.text-entry input { flex: 1; min-width: 0; }.text-entry button { flex: none; min-height: 88rpx; margin: 0; color: var(--color-primary); background: transparent; font-size: 23rpx; }.compact-loading { margin-top: 20rpx; padding: 24rpx; border-radius: 22rpx; color: var(--color-primary); background: var(--color-tint); text-align: center; }.file-line { display: flex; margin-top: 20rpx; padding: 22rpx; align-items: center; justify-content: space-between; gap: 16rpx; border: 1rpx solid var(--color-line); border-radius: 22rpx; background: var(--color-surface); }.file-line view { min-width: 0; }.file-line view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.file-line view text:first-child { color: var(--color-text); font-size: 26rpx; }.file-line view text:last-child { color: var(--color-muted); font-size: 21rpx; }.file-line > text { flex: none; color: var(--color-primary); font-size: 21rpx; }.preview-panel { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }.preview-panel > view { display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--color-line); color: var(--color-text-secondary); font-size: 24rpx; }.preview-panel > view text:last-child { max-width: 65%; text-align: right; overflow-wrap: anywhere; }.confidence { display: block; margin-top: 14rpx; color: var(--color-warning); font-size: 22rpx; }.stage-button { width: 100%; margin-top: 22rpx; }
@keyframes orbit { to { transform: rotate(360deg); } } @keyframes scan { from { transform: translateY(0); } to { transform: translateY(92rpx); } } @keyframes progress { from { transform: translateX(-20%); } to { transform: translateX(140%); } }
@media (prefers-reduced-motion: reduce) { .scan-orbit, .sheet-core view, .progress view { animation: none; }.progress view { width: 70%; transform: none; } }
@media (max-width: 340px) { .missing-row { padding: 16rpx 12rpx; }.amount { max-width: 30%; font-size: 22rpx; }.duplicate-actions button { font-size: 21rpx; } }
