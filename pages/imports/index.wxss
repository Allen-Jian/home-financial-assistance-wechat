.imports-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.action-grid { display: flex; gap: 16rpx; margin-top: 36rpx; }.action-grid button { flex: 1; padding: 22rpx 0; border-radius: 20rpx; color: #127c73; background: #e8f3ef; font-size: 26rpx; }.file-card, .preview-card { margin-top: 22rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; }.file-name, .file-meta, .preserved { display: block; }.file-name { color: #123b38; font-size: 28rpx; font-weight: 700; }.file-meta { margin-top: 8rpx; color: #78918d; font-size: 22rpx; }.preserved { margin-top: 12rpx; color: #127c73; font-size: 22rpx; }.preview-line { display: flex; justify-content: space-between; padding: 14rpx 0; color: #3d5753; font-size: 25rpx; border-bottom: 1rpx solid #e2efeb; }.confidence { display: block; margin-top: 14rpx; color: #9b671c; font-size: 22rpx; }.section-title { color: #123b38; font-size: 27rpx; font-weight: 700; }.error { display: block; margin-top: 18rpx; color: #c54545; font-size: 24rpx; }.primary-button { margin-top: 28rpx; color: #fff; background: #127c73; }
