<page-meta page-style="{{themePageStyle}}" />
<view class="page imports-page {{themeClass}}">
  <view class="imports-header"><text>{{mode === 'statement' ? '银行对账' : '导入工作台'}}</text><text>{{mode === 'statement' ? 'AI 核对已有账目，不会自动入账' : '原件先保留，确认后才入账'}}</text></view>

  <view wx:if="{{mode === 'statement' && view === 'upload'}}" class="statement-upload">
    <view class="statement-intro"><text>导入银行账单</text><text>支持 CSV 和 PDF。AI 会与现有账目核对，不会自动入账。</text></view>
    <button class="upload-card" bindtap="chooseFile"><view class="upload-file-icon"></view><text>选择银行账单文件</text><text>例如 ANZ 月度账单或交易流水</text></button>
    <button class="csv-button secondary-button" bindtap="chooseCsv">选择 CSV 流水</button>
    <view class="safety-note"><text>✓</text><text>只有确认勾选的缺失项目才会补录到账本。</text></view>
  </view>

  <view wx:if="{{mode === 'statement' && view === 'analyzing'}}" class="analysis-state">
    <view class="ai-scanner motion-safe"><view class="scan-orbit"></view><view class="sheet-core"><view></view></view></view>
    <text class="analysis-title">AI 正在核对银行流水</text><text class="analysis-status">正在读取交易日期与金额…</text><view class="progress motion-safe"><view></view></view><text class="analysis-note">正在与账本逐笔匹配，并检查重复与遗漏</text>
  </view>

  <view wx:if="{{mode === 'statement' && view === 'results'}}" class="reconcile-results">
    <view class="reconcile-done"><text>✓</text><view><text>对账完成</text><text>共分析 {{rows.length}} 笔银行流水</text></view></view>
    <view class="reconcile-counts"><view><text>{{matched.length}}</text><text>已匹配</text></view><view><text>{{duplicates.length}}</text><text>疑似重复</text></view><view><text>{{missing.length}}</text><text>账本缺失</text></view></view>
    <view wx:if="{{missing.length}}" class="result-section"><view class="result-head"><text>账本缺失</text><text>默认勾选</text></view><view wx:for="{{missing}}" wx:key="sourceFingerprint" class="missing-row" bindtap="toggleMissing" data-id="{{item.sourceFingerprint}}"><checkbox checked="{{item.selected}}" color="#2F6F64" /><view><text>{{item.merchant || '未命名交易'}}</text><text>{{item.date}} · {{item.direction === 'expense' ? '支出' : '收入'}}</text></view><text class="amount {{item.direction}}">{{item.amountDisplay}}</text></view></view>
    <view wx:if="{{duplicates.length}}" class="result-section"><view class="result-head"><text>疑似重复</text><text>需要人工决定</text></view><view wx:for="{{duplicates}}" wx:key="sourceFingerprint" class="duplicate-row"><view><text>{{item.merchant || '未命名交易'}} · {{item.amountDisplay}}</text><text>{{item.date}} · 日期或金额接近现有记录</text></view><view class="duplicate-actions"><button bindtap="resolveDuplicate" data-id="{{item.sourceFingerprint}}" data-action="later">稍后处理</button><button bindtap="resolveDuplicate" data-id="{{item.sourceFingerprint}}" data-action="keep-both">保留两笔</button></view><text wx:if="{{item.resolution}}" class="resolution">{{item.resolution === 'later' ? '已留待稍后处理' : '已确认保留两笔'}}</text></view></view>
    <view wx:if="{{matched.length}}" class="matched-note"><text>✓</text><text>其余 {{matched.length}} 笔已在账本中找到匹配记录</text></view>
    <text wx:if="{{confirmedMissingCount}}" class="success-copy">已确认补录 {{confirmedMissingCount}} 笔</text><text wx:if="{{error}}" class="page-error">{{error}}</text><button class="primary-button confirm-button" bindtap="confirmSelectedMissing" loading="{{loading}}">{{selectedMissingCount ? '确认补录选中账目' : '请选择需要补录的账目'}}</button>
  </view>

  <view wx:if="{{mode !== 'statement'}}" class="bill-workbench">
    <view class="action-grid"><button bindtap="choosePhoto"><view class="mini-icon camera"></view><text>拍照</text></button><button bindtap="chooseAlbum"><view class="mini-icon image"></view><text>相册</text></button><button bindtap="chooseFile"><view class="mini-icon file"></view><text>微信文件</text></button><button bindtap="chooseCsv"><view class="mini-icon sheet"></view><text>CSV</text></button></view>
    <view class="text-entry focus-surface"><input placeholder="例如：昨天超市花了 18.90" bindconfirm="parseText" confirm-type="done"/><button bindtap="parseText">AI 解析</button></view>
    <view wx:if="{{loading}}" class="compact-loading"><text>AI 正在分析文件…</text></view>
    <view wx:if="{{file && !loading}}" class="file-line"><view><text>{{file.name}}</text><text>{{file.contentType}}</text></view><text wx:if="{{originalPreserved}}">原件已保留</text></view>
    <view wx:if="{{preview && !loading}}" class="preview-panel"><view><text>商户</text><text>{{preview.merchant || '未识别'}}</text></view><view><text>金额</text><text>{{previewAmountDisplay}}</text></view><view><text>日期</text><text>{{preview.occurredAt || '未识别'}}</text></view><view wx:if="{{preview.categoryHint}}"><text>建议分类</text><text>{{preview.categoryHint}}</text></view><text class="confidence">AI 置信度 {{preview.confidence || 0}}</text></view>
    <text wx:if="{{error}}" class="page-error">{{error}}</text><button wx:if="{{file || preview}}" class="primary-button stage-button" loading="{{loading}}" bindtap="stage">生成待确认草稿</button>
  </view>
</view>
