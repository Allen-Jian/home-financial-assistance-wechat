.dashboard-page { min-height: 100vh; padding: 40rpx 32rpx 140rpx; box-sizing: border-box; background: var(--color-background); }
.topline { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow { display: block; color: var(--color-muted); font-size: 24rpx; }
.heading { display: block; margin-top: 8rpx; color: var(--color-text); font-size: 38rpx; font-weight: 700; }
.cache-label { padding: 10rpx 16rpx; color: var(--color-warning); background: var(--color-warning-surface); border-radius: 20rpx; font-size: 22rpx; }
.net-worth-card { margin-top: 36rpx; padding: 34rpx; border-radius: 28rpx; color: var(--color-on-primary); background: linear-gradient(135deg, var(--color-primary), var(--color-gradient-secondary)); box-shadow: 0 16rpx 40rpx var(--shadow-primary); }
.card-label, .card-foot { display: block; opacity: .82; font-size: 24rpx; }
.net-worth { display: block; margin: 16rpx 0; font-size: 64rpx; font-weight: 700; }
.metric-grid { display: flex; gap: 20rpx; margin-top: 20rpx; }
.metric { flex: 1; padding: 28rpx; border-radius: 24rpx; background: var(--color-surface); }
.metric text { display: block; color: var(--color-muted); font-size: 24rpx; }.metric text:last-child { margin-top: 12rpx; color: var(--color-text); font-size: 32rpx; font-weight: 700; }.income text:last-child { color: var(--color-income); }.expense text:last-child { color: var(--color-expense); }
.section-title { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 16rpx; color: var(--color-text); font-size: 30rpx; font-weight: 700; }.muted, .link { color: var(--color-muted); font-size: 22rpx; font-weight: 400; }
.todo-row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); color: var(--color-text-secondary); font-size: 26rpx; }.count { color: var(--color-primary); font-weight: 700; }.empty { padding: 40rpx 0; color: var(--color-muted); text-align: center; font-size: 26rpx; }
.insight-list { display: flex; flex-direction: column; gap: 16rpx; }.insight-card { padding: 24rpx; border-radius: 20rpx; background: var(--color-tint); }.insight-title { display: block; color: var(--color-text); font-size: 26rpx; font-weight: 700; }.insight-detail { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }
.floating-add { position: fixed; right: 36rpx; bottom: 120rpx; width: 112rpx; height: 112rpx; line-height: 104rpx; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); box-shadow: 0 12rpx 32rpx var(--shadow-primary); font-size: 60rpx; }
