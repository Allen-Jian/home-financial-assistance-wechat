.dashboard-page { min-height: 100vh; padding: 40rpx 32rpx 140rpx; box-sizing: border-box; background: #f4fbf8; }
.topline { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow { display: block; color: #6b817d; font-size: 24rpx; }
.heading { display: block; margin-top: 8rpx; color: #123b38; font-size: 38rpx; font-weight: 700; }
.cache-label { padding: 10rpx 16rpx; color: #9b671c; background: #fff4d6; border-radius: 20rpx; font-size: 22rpx; }
.net-worth-card { margin-top: 36rpx; padding: 34rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #127c73, #43a58e); box-shadow: 0 16rpx 40rpx rgba(18, 124, 115, .2); }
.card-label, .card-foot { display: block; opacity: .82; font-size: 24rpx; }
.net-worth { display: block; margin: 16rpx 0; font-size: 64rpx; font-weight: 700; }
.metric-grid { display: flex; gap: 20rpx; margin-top: 20rpx; }
.metric { flex: 1; padding: 28rpx; border-radius: 24rpx; background: #fff; }
.metric text { display: block; color: #6b817d; font-size: 24rpx; }.metric text:last-child { margin-top: 12rpx; color: #123b38; font-size: 32rpx; font-weight: 700; }.income text:last-child { color: #127c73; }.expense text:last-child { color: #c26f45; }
.section-title { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 16rpx; color: #123b38; font-size: 30rpx; font-weight: 700; }.muted, .link { color: #78918d; font-size: 22rpx; font-weight: 400; }
.todo-row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #e2efeb; color: #3d5753; font-size: 26rpx; }.count { color: #127c73; font-weight: 700; }.empty { padding: 40rpx 0; color: #78918d; text-align: center; font-size: 26rpx; }
.floating-add { position: fixed; right: 36rpx; bottom: 120rpx; width: 112rpx; height: 112rpx; line-height: 104rpx; border-radius: 50%; color: #fff; background: #127c73; box-shadow: 0 12rpx 32rpx rgba(18, 124, 115, .3); font-size: 60rpx; }
