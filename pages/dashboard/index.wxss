.dashboard-page { min-height: 100vh; padding: 30rpx 32rpx 0; padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); background: var(--color-background); }
.home-header, .balance-head, .balance-foot, .section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.home-kicker, .home-title { display: block; }.home-kicker { color: var(--color-muted); font-size: 24rpx; }.home-title { margin-top: 6rpx; color: var(--color-text); font-size: 38rpx; font-weight: 600; }
.cache-label { flex: none; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--color-warning); background: var(--color-warning-surface); font-size: 22rpx; }
.balance-card { margin-top: 30rpx; padding: 30rpx 34rpx; border-radius: 38rpx; color: #fff; background: var(--color-primary); box-shadow: 0 18rpx 38rpx var(--shadow-primary); }
.balance-head, .balance-foot { font-size: 23rpx; }.balance-head text:last-child { opacity: .82; }.balance-value { display: block; margin: 18rpx 0 24rpx; font-size: 58rpx; line-height: 1.12; font-weight: 500; letter-spacing: .5rpx; overflow-wrap: anywhere; }.balance-foot { align-items: flex-end; font-size: 21rpx; opacity: .94; }.balance-foot text { min-width: 0; }
.metric-grid, .quick-grid { display: flex; gap: 18rpx; }.metric-grid { margin-top: 20rpx; }.metric-card { flex: 1; min-width: 0; padding: 25rpx 24rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.metric-label, .metric-value { display: block; }.metric-label { color: var(--color-muted); font-size: 24rpx; }.metric-value { margin-top: 12rpx; font-size: 29rpx; font-weight: 600; overflow-wrap: anywhere; }.income { color: var(--color-income); }.expense { color: var(--color-expense); }
.home-section { margin-top: 36rpx; }.section-title { color: var(--color-text); font-size: 30rpx; font-weight: 600; }.section-note { color: var(--color-muted); font-size: 22rpx; }.text-button { min-height: 88rpx; margin: 0; padding: 0 8rpx; color: var(--color-primary); background: transparent; font-size: 23rpx; line-height: 88rpx; }
.quick-grid { margin-top: 18rpx; }.quick-action { display: flex; flex: 1 1 0; min-width: 0; min-height: 118rpx; margin: 0; padding: 22rpx 18rpx; align-items: center; justify-content: flex-start; gap: 16rpx; border-radius: 28rpx; text-align: left; }.quick-action view:last-child { min-width: 0; }.quick-action text { display: block; }.quick-action text:first-child { color: var(--color-text); font-size: 27rpx; font-weight: 600; }.quick-action text:last-child { margin-top: 5rpx; color: var(--color-text-secondary); font-size: 21rpx; }.photo-action { background: var(--color-accent); }.manual-action { border: 1rpx solid var(--color-line); background: var(--color-tint); }
.line-icon { position: relative; flex: none; width: 38rpx; height: 38rpx; color: var(--color-text); }.camera-icon { width: 35rpx; height: 26rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }.camera-icon::before { content: ''; position: absolute; left: 8rpx; top: -9rpx; width: 15rpx; height: 8rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 5rpx 5rpx 0 0; }.camera-icon::after { content: ''; position: absolute; left: 10rpx; top: 6rpx; width: 9rpx; height: 9rpx; border: 3rpx solid currentColor; border-radius: 50%; }.pencil-icon { width: 30rpx; height: 8rpx; margin-left: 3rpx; border: 3rpx solid currentColor; border-radius: 4rpx; transform: rotate(-45deg); }.pencil-icon::after { content: ''; position: absolute; right: -9rpx; top: -3rpx; border-width: 7rpx 0 7rpx 8rpx; border-style: solid; border-color: transparent transparent transparent currentColor; }
.transaction-list { margin-top: 16rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.transaction-row { display: flex; min-height: 100rpx; padding: 18rpx 20rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--color-line); box-sizing: border-box; }.transaction-row:last-child { border-bottom: 0; }.category-mark { display: flex; flex: none; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 18rpx; color: var(--color-expense); background: var(--color-expense-surface); font-size: 22rpx; }.category-mark.income { color: var(--color-income); background: var(--color-success-surface); }.transaction-main { flex: 1; min-width: 0; }.transaction-title, .transaction-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.transaction-title { color: var(--color-text); font-size: 29rpx; font-weight: 500; }.transaction-meta { margin-top: 5rpx; color: var(--color-muted); font-size: 24rpx; }.transaction-amount { flex: none; max-width: 40%; font-size: 27rpx; font-weight: 600; text-align: right; overflow-wrap: anywhere; }
.empty-state { margin-top: 16rpx; padding: 48rpx 30rpx 34rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); text-align: center; }.empty-receipt { width: 52rpx; height: 62rpx; margin: 0 auto; border: 3rpx solid var(--color-primary); border-radius: 8rpx; background: repeating-linear-gradient(to bottom, transparent 0 10rpx, var(--color-tint) 10rpx 14rpx); }.empty-title, .empty-copy { display: block; }.empty-title { margin-top: 20rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }.empty-copy { max-width: 500rpx; margin: 10rpx auto 0; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }.empty-state .primary-button { width: 100%; margin-top: 24rpx; }
.insight-strip { display: flex; width: 100%; min-height: 104rpx; margin-top: 28rpx; padding: 20rpx 22rpx; align-items: center; gap: 16rpx; border-radius: 28rpx; color: var(--color-text); background: var(--color-accent-surface); text-align: left; }.insight-strip view { flex: 1; min-width: 0; }.insight-strip text { display: block; }.insight-strip view text:first-child { font-size: 25rpx; font-weight: 600; }.insight-strip view text:last-child { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 22rpx; white-space: normal; }.spark-mark { color: var(--color-expense); font-size: 32rpx; }.chevron { color: var(--color-primary); font-size: 38rpx; }
@media (max-width: 340px) { .balance-foot { flex-direction: column; align-items: flex-start; gap: 4rpx; }.quick-action { padding: 20rpx 14rpx; gap: 12rpx; }.quick-action text:first-child { font-size: 25rpx; }.transaction-amount { max-width: 36%; font-size: 25rpx; } }
