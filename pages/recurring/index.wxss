.recurring-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.due-card { display: flex; justify-content: space-between; margin-top: 28rpx; padding: 28rpx; border-radius: 22rpx; color: #fff; background: #127c73; }.due-count { font-weight: 700; }.recurring-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #e2efeb; }.name, .date { display: block; }.name { color: #3d5753; font-size: 27rpx; }.date { margin-top: 8rpx; color: #78918d; font-size: 22rpx; }.amount { color: #c26f45; font-weight: 700; }.error { display: block; margin-top: 16rpx; color: #c54545; font-size: 24rpx; }
