.recurring-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.due-card { display: flex; justify-content: space-between; margin-top: 28rpx; padding: 28rpx; border-radius: 22rpx; color: var(--color-on-primary); background: var(--color-primary); }.due-count { font-weight: 700; }.recurring-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }.name, .date { display: block; }.name { color: var(--color-text-secondary); font-size: 27rpx; }.date { margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }.amount { color: var(--color-expense); font-weight: 700; }.error { display: block; margin-top: 16rpx; color: var(--color-expense); font-size: 24rpx; }
