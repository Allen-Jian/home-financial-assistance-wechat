<view class="page recurring-page"><view class="page-title"><text>周期账单</text><text class="sub">提醒到期日，不自动生成交易</text></view><view class="due-card"><text>待关注</text><text class="due-count">{{dueCount}} 项</text></view><block wx:for="{{templates}}" wx:key="id"><view class="recurring-row"><view><text class="name">{{item.name}}</text><text class="date">每月 {{item.dayOfMonth}} 日</text></view><text class="amount">NZ$ {{item.amountMinor / 100}}</text></view></block><text wx:if="{{error}}" class="error">{{error}}</text></view>
