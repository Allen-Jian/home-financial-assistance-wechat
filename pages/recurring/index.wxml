<page-meta page-style="{{themePageStyle}}" />
<view class="page recurring-page {{themeClass}}"><view class="page-title"><text>周期账单</text><text class="sub">提醒到期日，不自动生成交易</text></view><view class="due-card"><text>待关注</text><text class="due-count">{{dueCount}} 项</text></view><block wx:for="{{templates}}" wx:key="id"><view class="recurring-row"><view><text class="name">{{item.name}}</text><text class="date">每月 {{item.dayOfMonth}} 日</text></view><text class="amount money-number">{{item.amountDisplay}}</text></view></block><view wx:if="{{!templates.length && !loading}}" class="empty">还没有周期账单</view><text wx:if="{{error}}" class="error">{{error}}</text></view>
