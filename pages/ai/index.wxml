<view class="page ai-page"><view class="page-title"><text>AI 账本助手</text><text class="sub">{{notice}}</text></view><view class="quick-row"><block wx:for="{{quickQuestions}}" wx:key="*this"><button bindtap="quickQuestion" data-question="{{item}}">{{item}}</button></block></view><scroll-view scroll-y class="chat-list"><block wx:for="{{messages}}" wx:key="index"><view class="message {{item.role}}"><text>{{item.content}}</text><text wx:if="{{item.scope}}" class="scope">范围：{{item.scope.from}} — {{item.scope.to}}</text><block wx:for="{{item.insights}}" wx:key="title"><view class="insight"><text>{{item.title}}</text><text wx:if="{{item.value}}">{{item.value}} {{item.unit}}</text></view></block><block wx:for="{{item.citations}}" wx:key="transactionId"><text class="citation">引用：{{item.merchant || '未命名'}} · NZ$ {{item.amountMinor / 100}}</text></block></view></block></scroll-view><text wx:if="{{error}}" class="error">{{error}}</text><view class="composer"><input placeholder="问问家庭账本" bindconfirm="send" confirm-type="send"/><button class="primary-button" loading="{{loading}}" bindtap="send">发送</button></view><button class="delete-button" bindtap="deleteHistory">删除聊天记录</button></view>
