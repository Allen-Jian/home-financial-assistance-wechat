.ai-page { min-height: 100vh; padding: 36rpx 32rpx 40rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.quick-row { display: flex; gap: 12rpx; margin-top: 24rpx; }.quick-row button { flex: 1; padding: 14rpx 8rpx; color: var(--color-primary); background: var(--color-tint); font-size: 22rpx; }.chat-list { height: 760rpx; margin-top: 24rpx; }.message { max-width: 86%; margin-bottom: 18rpx; padding: 22rpx; border-radius: 20rpx; color: var(--color-text-secondary); background: var(--color-surface); font-size: 26rpx; }.message.user { margin-left: auto; color: var(--color-on-primary); background: var(--color-primary); }.scope, .citation { display: block; margin-top: 12rpx; color: var(--color-muted); font-size: 20rpx; }.message.user .scope, .message.user .citation { color: var(--color-on-primary-muted); }.error { display: block; color: var(--color-expense); font-size: 24rpx; }.composer { display: flex; gap: 12rpx; margin-top: 16rpx; }.composer input { flex: 1; padding: 0 20rpx; border-radius: 16rpx; background: var(--color-surface); }.primary-button { color: var(--color-on-primary); background: var(--color-primary); }.delete-button { margin-top: 18rpx; color: var(--color-muted); background: transparent; font-size: 22rpx; }
