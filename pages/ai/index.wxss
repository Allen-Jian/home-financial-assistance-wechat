.ai-page { min-height: 100vh; padding: 28rpx 28rpx calc(158rpx + env(safe-area-inset-bottom)); background: var(--color-background); }.ai-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.ai-title, .ai-notice { display: block; }.ai-title { color: var(--color-text); font-size: 38rpx; font-weight: 600; }.ai-notice { margin-top: 6rpx; color: var(--color-muted); font-size: 22rpx; }.shield-dot { display: inline-flex; width: 30rpx; height: 30rpx; margin-right: 8rpx; align-items: center; justify-content: center; border: 2rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); font-size: 16rpx; }.clear-chat { flex: none; min-height: 88rpx; margin: 0; padding: 0 16rpx; color: var(--color-muted); background: transparent; font-size: 23rpx; }
.suggestion-scroll { width: 100%; margin-top: 22rpx; white-space: nowrap; }.suggestions { display: inline-flex; gap: 12rpx; padding-right: 28rpx; }.suggestions button { min-height: 88rpx; margin: 0; padding: 14rpx 20rpx; border: 1rpx solid var(--color-line); border-radius: 999rpx; color: var(--color-primary); background: var(--color-surface); font-size: 23rpx; }
.chat-list { height: calc(100vh - 390rpx); margin-top: 18rpx; }.chat-empty { padding: 100rpx 28rpx 0; text-align: center; }.ai-orb { width: 82rpx; height: 82rpx; margin: auto; border: 4rpx solid var(--color-primary); border-radius: 50%; background: radial-gradient(circle at 35% 30%, var(--color-accent), var(--color-tint) 42%, var(--color-primary)); }.chat-empty text { display: block; }.chat-empty text:nth-child(2) { margin-top: 22rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }.chat-empty text:last-child { margin-top: 8rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.55; }
.message-row { display: flex; width: 100%; margin-bottom: 18rpx; }.message-row.user { justify-content: flex-end; }.message-row.assistant { justify-content: flex-start; }.message-bubble { display: block; width: fit-content; max-width: 78%; padding: 20rpx 22rpx; border-radius: 24rpx; color: var(--color-text-secondary); background: var(--color-surface); font-size: 26rpx; line-height: 1.58; box-sizing: border-box; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }.message-row.user .message-bubble { border-bottom-right-radius: 8rpx; color: var(--color-on-primary); background: var(--color-primary); }.message-row.assistant .message-bubble { border-left: 7rpx solid var(--color-accent); border-bottom-left-radius: 8rpx; }.assistant-label { display: flex; margin-bottom: 10rpx; align-items: center; gap: 10rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }.spark-icon { position: relative; width: 24rpx; height: 24rpx; }.spark-icon::before, .spark-icon::after { content: ''; position: absolute; left: 10rpx; top: 1rpx; width: 4rpx; height: 22rpx; border-radius: 4rpx; background: var(--color-accent); }.spark-icon::after { transform: rotate(90deg); }.message-content { display: block; overflow-wrap: anywhere; word-break: break-word; }.scope-row { display: flex; margin-top: 14rpx; gap: 6rpx; color: var(--color-muted); font-size: 20rpx; overflow-wrap: anywhere; }.insight-block { display: flex; margin-top: 12rpx; padding-top: 10rpx; align-items: baseline; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid var(--color-line); color: var(--color-text); background: var(--color-tint); font-size: 23rpx; overflow-wrap: anywhere; }.insight-block text:last-child { margin-left: auto; }.citation-list { margin-top: 12rpx; border-top: 1rpx solid var(--color-line); }.citation-row { display: flex; min-height: 62rpx; align-items: center; gap: 10rpx; color: var(--color-primary); font-size: 21rpx; overflow-wrap: anywhere; }.receipt-icon { flex: none; width: 24rpx; height: 30rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }.typing { display: flex; width: 80rpx; margin-bottom: 18rpx; padding: 20rpx; gap: 8rpx; border-radius: 22rpx; background: var(--color-surface); }.typing view { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--color-primary); animation: typing 1s ease-in-out infinite alternate; }.typing view:nth-child(2) { animation-delay: .2s; }.typing view:nth-child(3) { animation-delay: .4s; }
.composer { position: fixed; z-index: 5; left: 24rpx; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; min-height: 112rpx; padding: 12rpx 12rpx 12rpx 20rpx; align-items: flex-end; gap: 12rpx; border: 2rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-elevated); box-shadow: 0 12rpx 34rpx var(--shadow-card); }.composer textarea { flex: 1; min-width: 0; min-height: 68rpx; max-height: 170rpx; padding: 10rpx 0; color: var(--color-text); font-size: 25rpx; }.composer button { flex: none; width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); font-size: 34rpx; line-height: 84rpx; }
@keyframes typing { from { opacity: .35; transform: translateY(3rpx); } to { opacity: 1; transform: translateY(-3rpx); } } @media (prefers-reduced-motion: reduce) { .typing view { animation: none; } }
.ai-page { padding-bottom: calc(158rpx + env(safe-area-inset-bottom)); }
.composer { bottom: calc(112rpx + 20rpx + env(safe-area-inset-bottom)); }
