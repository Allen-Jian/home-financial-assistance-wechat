.ai-page { min-height: 100vh; padding: 36rpx 32rpx 40rpx; box-sizing: border-box; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.quick-row { display: flex; gap: 12rpx; margin-top: 24rpx; }.quick-row button { flex: 1; padding: 14rpx 8rpx; color: #127c73; background: #e8f3ef; font-size: 22rpx; }.chat-list { height: 760rpx; margin-top: 24rpx; }.message { max-width: 86%; margin-bottom: 18rpx; padding: 22rpx; border-radius: 20rpx; color: #3d5753; background: #fff; font-size: 26rpx; }.message.user { margin-left: auto; color: #fff; background: #127c73; }.scope, .citation { display: block; margin-top: 12rpx; color: #78918d; font-size: 20rpx; }.message.user .scope, .message.user .citation { color: #d4efea; }.error { display: block; color: #c54545; font-size: 24rpx; }.composer { display: flex; gap: 12rpx; margin-top: 16rpx; }.composer input { flex: 1; padding: 0 20rpx; border-radius: 16rpx; background: #fff; }.primary-button { color: #fff; background: #127c73; }.delete-button { margin-top: 18rpx; color: #78918d; background: transparent; font-size: 22rpx; }
