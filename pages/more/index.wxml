<page-meta page-style="{{themePageStyle}}" />
<view class="page settings-page {{themeClass}}">
  <view class="settings-header"><text>家庭账本</text><text>设置</text></view>
  <navigator url="/pages/household/index" class="profile-row"><text class="avatar">家</text><view><text>我的家庭</text><text>查看成员与权限</text></view><text class="chevron">›</text></navigator>
  <view class="settings-group"><text class="group-title">账本管理</text><navigator url="/pages/settings/categories/index" class="settings-row"><text class="row-mark">类</text><view><text>分类管理</text><text>新增、改名、停用或恢复</text></view><text class="chevron">›</text></navigator><navigator url="/pages/settings/assets/index" class="settings-row"><text class="row-mark">资</text><view><text>初始资产</text><text>调整家庭账本起点</text></view><text class="chevron">›</text></navigator><navigator url="/pages/settings/term-deposits/index" class="settings-row"><text class="row-mark">定</text><view><text>定期存款</text><text>记录本金、利率与到期日</text></view><text class="chevron">›</text></navigator><navigator url="/pages/recurring/index" class="settings-row"><text class="row-mark">周</text><view><text>周期账单</text><text>管理固定账单提醒</text></view><text class="chevron">›</text></navigator></view>
  <view class="settings-group"><text class="group-title">数据与智能</text><view class="settings-row static appearance-row"><text class="row-mark">月</text><view class="appearance-copy"><text>外观</text><text>跟随系统自动切换深浅色</text></view><view class="appearance-control"><view class="appearance-selector"><view wx:for="{{appearanceOptions}}" wx:for-item="item" wx:key="value" class="appearance-option {{themePreference == item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onAppearanceSelect"><text>{{item.label}}</text></view></view><text wx:if="{{themePersistenceWarning}}" class="theme-persistence-warning">{{themePersistenceWarning}}</text></view></view><navigator url="/pages/reports/index" class="settings-row"><text class="row-mark">导</text><view><text>导出数据</text><text>下载 CSV 或 JSON</text></view><text class="chevron">›</text></navigator><navigator open-type="switchTab" url="/pages/ai/index" class="settings-row"><text class="row-mark">AI</text><view><text>AI 与聊天记录</text><text>查看或清除私有对话</text></view><text class="chevron">›</text></navigator></view>
  <view class="export-actions"><button class="secondary-button" bindtap="exportCsv">导出本月 CSV</button><button class="secondary-button" bindtap="exportJson">导出本月 JSON</button></view>
  <view class="settings-group"><text class="group-title">安全</text><view class="settings-row static"><text class="row-mark">密</text><view><text>账号与密码</text><text>密码修改功能将在后续安全页提供</text></view><text class="status-label">只读</text></view></view>
  <button bindtap="logout" class="logout">退出登录</button>
</view>
