.more-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.menu-row { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 28rpx 24rpx; border-radius: 20rpx; background: var(--color-surface); color: var(--color-text-secondary); font-size: 28rpx; }.menu-row span { color: var(--color-muted); }.logout { margin-top: 44rpx; color: var(--color-expense); background: var(--color-expense-surface); font-size: 26rpx; }
