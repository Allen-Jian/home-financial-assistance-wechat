.settings-page { min-height: 100vh; padding: 30rpx 32rpx 64rpx; background: var(--color-background); }.settings-header text { display: block; }.settings-header text:first-child { color: var(--color-muted); font-size: 23rpx; }.settings-header text:last-child { margin-top: 4rpx; color: var(--color-text); font-size: 40rpx; font-weight: 600; }.profile-row { display: flex; min-height: 118rpx; margin-top: 24rpx; padding: 20rpx; align-items: center; gap: 16rpx; border: 1rpx solid var(--color-line); border-radius: 30rpx; background: var(--color-surface); }.avatar { display: flex; flex: none; width: 70rpx; height: 70rpx; align-items: center; justify-content: center; border-radius: 24rpx; color: var(--color-on-primary); background: var(--color-primary); font-size: 30rpx; font-weight: 600; }.profile-row view { flex: 1; min-width: 0; }.profile-row view text, .settings-row view text { display: block; }.profile-row view text:first-child { color: var(--color-text); font-size: 28rpx; font-weight: 600; }.profile-row view text:last-child { margin-top: 4rpx; color: var(--color-muted); font-size: 22rpx; }.chevron { flex: none; color: var(--color-primary); font-size: 36rpx; }
.settings-group { margin-top: 28rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.group-title { display: block; padding: 20rpx 22rpx 8rpx; color: var(--color-muted); font-size: 21rpx; }.settings-row { display: flex; min-height: 100rpx; margin: 0 20rpx; padding: 16rpx 2rpx; align-items: center; gap: 14rpx; border-bottom: 1rpx solid var(--color-line); box-sizing: border-box; }.settings-row:last-child { border-bottom: 0; }.settings-row.static { color: inherit; }.row-mark { display: flex; flex: none; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border-radius: 17rpx; color: var(--color-primary); background: var(--color-tint); font-size: 20rpx; font-weight: 600; }.settings-row view { flex: 1; min-width: 0; }.settings-row view text:first-child { color: var(--color-text); font-size: 26rpx; font-weight: 500; }.settings-row view text:last-child { margin-top: 4rpx; color: var(--color-muted); font-size: 21rpx; white-space: normal; }.status-label { flex: none; color: var(--color-muted); font-size: 21rpx; }.export-actions { display: flex; margin-top: 14rpx; gap: 12rpx; }.export-actions button { flex: 1; min-width: 0; margin: 0; padding: 10rpx; font-size: 23rpx; }.logout { width: 100%; margin-top: 28rpx; border-radius: 24rpx; color: var(--color-expense); background: var(--color-expense-surface); font-size: 26rpx; }
@media (max-width: 340px) { .settings-row { margin: 0 14rpx; }.row-mark { width: 48rpx; height: 48rpx; }.settings-row view text:last-child { font-size: 20rpx; }.export-actions { flex-direction: column; }.export-actions button { width: 100%; } }
.appearance-row { align-items: flex-start; }.appearance-copy { flex: 1; }.appearance-control { flex: 1.35; min-width: 0; }.appearance-selector { display: flex; margin-top: 2rpx; gap: 6rpx; }.appearance-option { flex: 1; min-width: 0; padding: 12rpx 6rpx; border: 1rpx solid var(--color-line); border-radius: 14rpx; color: var(--color-muted); background: var(--color-background); font-size: 20rpx; text-align: center; }.appearance-option.selected { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-tint); font-weight: 600; }.appearance-option text { display: block; white-space: nowrap; }.theme-persistence-warning { display: block; margin-top: 8rpx; color: var(--color-expense); font-size: 19rpx; line-height: 1.4; white-space: normal; }
.settings-page { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }
