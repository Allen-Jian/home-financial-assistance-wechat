<view class="page household-page"><view class="page-title"><text>我的家庭</text><text class="sub">成员共享同一本账</text></view><view class="member-list"><block wx:for="{{members}}" wx:key="membershipId"><view class="member-row"><view><text class="name">{{item.username}}</text><text class="role">{{item.role === 'owner' ? '所有者' : '成员'}}</text></view><button wx:if="{{role === 'owner' && item.role !== 'owner'}}" data-id="{{item.membershipId}}">移除</button></view></block></view><view wx:if="{{role === 'owner'}}" class="invite-card"><text class="invite-title">邀请家庭成员</text><text wx:if="{{invite}}" class="invite-code">{{invite.code}}</text><button wx:if="{{invite}}" bindtap="copyInvite">{{copied ? '已复制' : '复制邀请码'}}</button><button bindtap="createInvite">生成 7 天邀请码</button></view><text wx:if="{{error}}" class="error">{{error}}</text></view>
