.household-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.member-list, .invite-card { margin-top: 28rpx; padding: 0 24rpx; border-radius: 22rpx; background: var(--color-surface); }.member-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }.name, .role { display: block; }.name { color: var(--color-text-secondary); font-size: 28rpx; }.role { margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }.member-row button { margin: 0; padding: 0 18rpx; color: var(--color-expense); background: var(--color-expense-surface); font-size: 22rpx; }.invite-card { padding: 28rpx 24rpx; }.invite-title { display: block; color: var(--color-text); font-size: 28rpx; font-weight: 700; }.invite-code { display: block; margin: 18rpx 0; color: var(--color-primary); letter-spacing: 4rpx; font-size: 38rpx; font-weight: 700; }.invite-card button { margin-top: 14rpx; color: var(--color-primary); background: var(--color-tint); font-size: 24rpx; }.error { display: block; margin-top: 18rpx; color: var(--color-expense); font-size: 24rpx; }
