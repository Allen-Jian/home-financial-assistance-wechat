.household-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.member-list, .invite-card { margin-top: 28rpx; padding: 0 24rpx; border-radius: 22rpx; background: #fff; }.member-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #e2efeb; }.name, .role { display: block; }.name { color: #3d5753; font-size: 28rpx; }.role { margin-top: 8rpx; color: #78918d; font-size: 22rpx; }.member-row button { margin: 0; padding: 0 18rpx; color: #c54545; background: #fff1ef; font-size: 22rpx; }.invite-card { padding: 28rpx 24rpx; }.invite-title { display: block; color: #123b38; font-size: 28rpx; font-weight: 700; }.invite-code { display: block; margin: 18rpx 0; color: #127c73; letter-spacing: 4rpx; font-size: 38rpx; font-weight: 700; }.invite-card button { margin-top: 14rpx; color: #127c73; background: #e8f3ef; font-size: 24rpx; }.error { display: block; margin-top: 18rpx; color: #c54545; font-size: 24rpx; }
