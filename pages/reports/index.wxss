.reports-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }.period-switch { display: flex; gap: 12rpx; margin-top: 30rpx; }.period-switch button { flex: 1; color: var(--color-muted); background: var(--color-tint); font-size: 24rpx; }.period-switch .active { color: var(--color-on-primary); background: var(--color-primary); }.cashflow-card, .section { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: var(--color-surface); }.cashflow-card > text:first-child { color: var(--color-muted); font-size: 24rpx; }.cashflow { display: block; margin: 12rpx 0 18rpx; color: var(--color-primary); font-size: 52rpx; font-weight: 700; }.cashflow-line { display: flex; justify-content: space-between; color: var(--color-muted); font-size: 24rpx; }.section-title { color: var(--color-text); font-size: 28rpx; font-weight: 700; }.breakdown-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-line); color: var(--color-text-secondary); font-size: 25rpx; }.export-row { display: flex; gap: 16rpx; margin-top: 24rpx; }.export-row button { flex: 1; color: var(--color-primary); background: var(--color-tint); font-size: 24rpx; }.error { display: block; margin-top: 16rpx; color: var(--color-expense); font-size: 24rpx; }
