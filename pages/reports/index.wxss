.reports-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }.period-switch { display: flex; gap: 12rpx; margin-top: 30rpx; }.period-switch button { flex: 1; color: #6b817d; background: #e8f3ef; font-size: 24rpx; }.period-switch .active { color: #fff; background: #127c73; }.cashflow-card, .section { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }.cashflow-card > text:first-child { color: #78918d; font-size: 24rpx; }.cashflow { display: block; margin: 12rpx 0 18rpx; color: #127c73; font-size: 52rpx; font-weight: 700; }.cashflow-line { display: flex; justify-content: space-between; color: #6b817d; font-size: 24rpx; }.section-title { color: #123b38; font-size: 28rpx; font-weight: 700; }.breakdown-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #e2efeb; color: #3d5753; font-size: 25rpx; }.export-row { display: flex; gap: 16rpx; margin-top: 24rpx; }.export-row button { flex: 1; color: #127c73; background: #e8f3ef; font-size: 24rpx; }.error { display: block; margin-top: 16rpx; color: #c54545; font-size: 24rpx; }
