.manual-page { min-height: 100vh; padding: 88rpx 32rpx 64rpx; background: var(--color-background); }.entry-appbar { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.entry-appbar > text { color: var(--color-text); font-size: 32rpx; font-weight: 600; }.close-button, .appbar-spacer { width: 88rpx; }.close-button { margin: 0; padding: 0; border-radius: 50%; color: var(--color-text); background: var(--color-surface); font-size: 40rpx; line-height: 84rpx; }.manual-header { margin-top: 28rpx; }.manual-header text { display: block; }.manual-header text:first-child { color: var(--color-text); font-size: 40rpx; font-weight: 600; }.manual-header text:last-child { margin-top: 6rpx; color: var(--color-muted); font-size: 24rpx; }
.direction-switch { display: flex; margin-top: 28rpx; padding: 6rpx; gap: 6rpx; border-radius: 24rpx; background: var(--color-tint); }.direction-switch button { flex: 1; min-height: 88rpx; margin: 0; padding: 0; border-radius: 18rpx; color: var(--color-muted); background: transparent; }.direction-switch .active { color: var(--color-on-primary); background: var(--color-primary); }
.amount-field { margin-top: 18rpx; padding: 22rpx 24rpx; border: 2rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.amount-field > text { display: block; color: var(--color-muted); font-size: 23rpx; }.amount-field > view { display: flex; margin-top: 8rpx; align-items: center; }.amount-field view > text { color: var(--color-primary); font-size: 32rpx; font-weight: 600; }.amount-field input { flex: 1; min-width: 0; margin-left: 14rpx; color: var(--color-text); font-size: 58rpx; font-weight: 500; }
.inline-field { display: flex; min-height: 96rpx; margin-top: 16rpx; padding: 20rpx 22rpx; align-items: center; gap: 18rpx; border: 2rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }.inline-field > text { flex: none; color: var(--color-text-secondary); font-size: 25rpx; }.inline-field input { flex: 1; min-width: 0; color: var(--color-text); text-align: right; font-size: 26rpx; }
.category-section { margin-top: 24rpx; }.category-title { color: var(--color-text); font-size: 29rpx; font-weight: 600; }.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 14rpx; }.category-grid button { min-width: 0; min-height: 88rpx; margin: 0; padding: 8rpx; border: 2rpx solid var(--color-line); border-radius: 20rpx; color: var(--color-text-secondary); background: var(--color-surface); font-size: 24rpx; }.category-grid .active { border-color: var(--color-accent); color: var(--color-warning); background: var(--color-accent-surface); }.category-empty { display: block; margin-top: 14rpx; padding: 22rpx; border-radius: 20rpx; color: var(--color-muted); background: var(--color-surface); font-size: 23rpx; text-align: center; }
.form-group { margin-top: 18rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.form-row { display: flex; min-height: 98rpx; padding: 18rpx 22rpx; align-items: center; justify-content: space-between; }.form-row view text { display: block; }.form-row view text:first-child, .note-field > text { color: var(--color-muted); font-size: 22rpx; }.form-row view text:last-child { margin-top: 3rpx; color: var(--color-text); font-size: 26rpx; }.chevron { color: var(--color-primary); font-size: 38rpx; }.note-field { display: block; padding: 18rpx 22rpx; border-top: 1rpx solid var(--color-line); }.note-field textarea { width: 100%; min-height: 116rpx; margin-top: 8rpx; color: var(--color-text); font-size: 26rpx; }.safety-note { display: flex; margin-top: 18rpx; padding: 18rpx 20rpx; align-items: center; gap: 12rpx; border-radius: 20rpx; color: var(--color-text-secondary); background: var(--color-tint); font-size: 22rpx; }.safety-note > text:first-child { color: var(--color-primary); font-weight: 700; }.save-button { width: 100%; margin-top: 22rpx; }.duplicate-actions { display: flex; margin-top: 18rpx; gap: 14rpx; }.duplicate-actions button { flex: 1; min-width: 0; margin: 0; }
