<view class="page ledger-list-page">
  <view class="page-title"><text>账目</text><text class="sub">只读查看已确认的收入与支出</text></view>
  <view class="period-tabs">
    <button bindtap="changeMonth" data-delta="-1">上月</button>
    <button bindtap="changePeriod" data-mode="month" class="{{periodMode === 'month' ? 'active' : ''}}">本月</button>
    <button bindtap="changeMonth" data-delta="1">下月</button>
    <button bindtap="changePeriod" data-mode="year" class="{{periodMode === 'year' ? 'active' : ''}}">本年</button>
    <button bindtap="changePeriod" data-mode="custom" class="{{periodMode === 'custom' ? 'active' : ''}}">自定义</button>
  </view>
  <view wx:if="{{periodMode === 'custom'}}" class="custom-period">
    <picker mode="date" value="{{customFrom}}" bindchange="onCustomFrom"><view class="date-picker">{{customFrom || '开始日期'}}</view></picker>
    <text class="date-separator">至</text>
    <picker mode="date" value="{{customTo}}" bindchange="onCustomTo"><view class="date-picker">{{customTo || '结束日期'}}</view></picker>
    <button bindtap="applyCustomPeriod" class="apply-button">应用</button>
  </view>
  <view wx:if="{{loading}}" class="status">正在加载账目…</view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view wx:if="{{!loading && transactions.length === 0}}" class="empty">这个期间还没有账目</view>
  <view wx:for="{{transactions}}" wx:key="id" class="transaction-card" bindtap="openDetail" data-id="{{item.id}}">
    <view class="transaction-main"><text class="merchant">{{item.merchant || item.note || '未命名账目'}}</text><text class="date">{{item.dateDisplay}} · {{item.directionLabel}}</text></view>
    <text class="amount {{item.direction}}">{{item.amountDisplay}}</text>
  </view>
  <view wx:if="{{selectedTransaction}}" class="detail-panel">
    <view class="detail-header"><text>账目详情</text><text bindtap="closeDetail" class="close">关闭</text></view>
    <view class="detail-row"><text>类型</text><text>{{selectedDirectionLabel}}</text></view>
    <view class="detail-row"><text>金额</text><text>{{selectedAmountDisplay}}</text></view>
    <view class="detail-row"><text>日期</text><text>{{selectedDateDisplay}}</text></view>
    <view wx:if="{{selectedTransaction.merchant}}" class="detail-row"><text>商户</text><text>{{selectedTransaction.merchant}}</text></view>
    <view wx:if="{{selectedTransaction.note}}" class="detail-row"><text>备注</text><text>{{selectedTransaction.note}}</text></view>
  </view>
</view>
