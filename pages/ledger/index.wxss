.ledger-list-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }
.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.period-tabs { display: flex; gap: 12rpx; margin-top: 30rpx; }.period-tabs button { flex: 1; height: 68rpx; line-height: 68rpx; border-radius: 16rpx; color: var(--color-muted); background: var(--color-tint); font-size: 24rpx; }.period-tabs .active { color: var(--color-on-primary); background: var(--color-primary); }
.custom-period { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; }.date-picker { padding: 18rpx 14rpx; border-radius: 14rpx; color: var(--color-text-secondary); background: var(--color-surface); font-size: 24rpx; }.date-separator { color: var(--color-muted); }.apply-button { margin: 0; padding: 0 20rpx; height: 64rpx; line-height: 64rpx; color: var(--color-on-primary); background: var(--color-primary); font-size: 24rpx; }
.transaction-card { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; padding: 24rpx; border-radius: 20rpx; background: var(--color-surface); }.merchant, .date { display: block; }.merchant { color: var(--color-text-secondary); font-size: 28rpx; }.date { margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }.amount { color: var(--color-income); font-size: 28rpx; font-weight: 700; }.amount.expense { color: var(--color-expense); }.amount.transfer, .amount.adjustment { color: var(--color-text-secondary); }
.status, .empty { display: block; padding: 52rpx 0; color: var(--color-muted); text-align: center; font-size: 26rpx; }.error { display: block; margin-top: 20rpx; color: var(--color-expense); font-size: 24rpx; }
.detail-panel { margin-top: 26rpx; padding: 26rpx; border-radius: 22rpx; background: var(--color-tint); }.detail-header, .detail-row { display: flex; justify-content: space-between; align-items: center; }.detail-header { color: var(--color-text); font-size: 30rpx; font-weight: 700; }.close { color: var(--color-primary); font-size: 24rpx; font-weight: 400; }.detail-row { padding: 18rpx 0; border-bottom: 1rpx solid var(--color-line); color: var(--color-text-secondary); font-size: 25rpx; }
