.ledger-page { min-height: 100vh; padding: 30rpx 32rpx 64rpx; background: var(--color-background); }.ledger-title, .ledger-subtitle { display: block; }.ledger-title { color: var(--color-text); font-size: 40rpx; font-weight: 600; }.ledger-subtitle { margin-top: 6rpx; color: var(--color-muted); font-size: 24rpx; }
.period-nav { display: flex; margin-top: 26rpx; align-items: center; justify-content: space-between; }.period-nav button { width: 88rpx; margin: 0; padding: 0; color: var(--color-primary); background: transparent; font-size: 48rpx; }.period-nav text { color: var(--color-text); font-size: 29rpx; font-weight: 600; }.period-segment { display: flex; margin-top: 10rpx; padding: 6rpx; gap: 6rpx; border-radius: 24rpx; background: var(--color-tint); }.period-segment button { flex: 1; min-height: 88rpx; margin: 0; padding: 0; border-radius: 18rpx; color: var(--color-muted); background: transparent; font-size: 25rpx; }.period-segment .active { color: var(--color-on-primary); background: var(--color-primary); }
.custom-period { display: flex; margin-top: 16rpx; align-items: center; gap: 10rpx; color: var(--color-muted); font-size: 22rpx; }.custom-period picker { flex: 1; min-width: 0; }.date-picker { min-height: 88rpx; padding: 18rpx 12rpx; border: 2rpx solid var(--color-line); border-radius: 18rpx; color: var(--color-text-secondary); background: var(--color-surface); text-align: center; font-size: 22rpx; }.apply-button { flex: none; min-height: 88rpx; margin: 0; padding: 0 18rpx; border-radius: 18rpx; color: var(--color-on-primary); background: var(--color-primary); font-size: 23rpx; }
.cashflow-card { display: flex; margin-top: 22rpx; padding: 25rpx 18rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.cashflow-card view { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; }.cashflow-card view + view { border-left: 1rpx solid var(--color-line); }.cashflow-card text { display: block; color: var(--color-muted); font-size: 22rpx; }.cashflow-card text:last-child { margin-top: 8rpx; color: var(--color-text); font-size: 25rpx; font-weight: 600; overflow-wrap: anywhere; }.cashflow-card .income { color: var(--color-income); }.cashflow-card .expense { color: var(--color-expense); }
.bank-import { display: flex; width: 100%; min-height: 116rpx; margin-top: 20rpx; padding: 20rpx; align-items: center; gap: 16rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); text-align: left; }.bank-import view:nth-child(2) { flex: 1; min-width: 0; }.bank-import text { display: block; }.bank-import view:nth-child(2) text:first-child { color: var(--color-text); font-size: 27rpx; font-weight: 600; }.bank-import view:nth-child(2) text:last-child { margin-top: 5rpx; color: var(--color-muted); font-size: 22rpx; white-space: normal; }.bank-file-icon { position: relative; flex: none; width: 56rpx; height: 64rpx; border: 3rpx solid var(--color-primary); border-radius: 10rpx; background: var(--color-tint); }.bank-file-icon::before, .bank-file-icon::after { content: ''; position: absolute; left: 12rpx; right: 12rpx; height: 3rpx; background: var(--color-primary); }.bank-file-icon::before { top: 20rpx; }.bank-file-icon::after { top: 34rpx; }.chevron { flex: none; color: var(--color-primary); font-size: 40rpx; }
.status { display: block; padding: 46rpx 0; color: var(--color-muted); text-align: center; font-size: 25rpx; }.ledger-list { margin-top: 24rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); }.ledger-row { display: flex; width: 100%; min-height: 106rpx; margin: 0; padding: 18rpx 16rpx; align-items: center; gap: 14rpx; border-bottom: 1rpx solid var(--color-line); border-radius: 0; background: transparent; text-align: left; }.ledger-row:last-child { border-bottom: 0; }.category-mark { display: flex; flex: none; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 18rpx; color: var(--color-expense); background: var(--color-expense-surface); font-size: 22rpx; }.category-mark.income { color: var(--color-income); background: var(--color-success-surface); }.ledger-row-main { flex: 1; min-width: 0; }.ledger-row-main text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.ledger-row-main text:first-child { color: var(--color-text); font-size: 29rpx; font-weight: 500; }.ledger-row-main text:last-child { margin-top: 5rpx; color: var(--color-muted); font-size: 24rpx; }.row-amount { flex: none; max-width: 34%; color: var(--color-income); font-size: 27rpx; font-weight: 600; text-align: right; overflow-wrap: anywhere; }.row-amount.expense { color: var(--color-expense); }.ledger-row .chevron { font-size: 30rpx; }
.ledger-empty { margin-top: 28rpx; padding: 48rpx 28rpx 30rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); text-align: center; }.empty-receipt { width: 52rpx; height: 62rpx; margin: 0 auto; border: 3rpx solid var(--color-primary); border-radius: 8rpx; background: repeating-linear-gradient(to bottom, transparent 0 10rpx, var(--color-tint) 10rpx 14rpx); }.empty-title, .empty-copy { display: block; }.empty-title { margin-top: 20rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }.empty-copy { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }.ledger-empty button { width: 100%; margin-top: 20rpx; }.ledger-empty .secondary-button { margin-top: 12rpx; }
.detail-panel { position: fixed; z-index: 10; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); padding: 28rpx; border: 1rpx solid var(--color-line); border-radius: 32rpx; background: var(--color-elevated); box-shadow: 0 22rpx 70rpx rgba(0,0,0,.18); }.detail-head, .detail-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.detail-head { color: var(--color-text); font-size: 30rpx; font-weight: 600; }.detail-head button { width: 88rpx; margin: 0; padding: 0; color: var(--color-primary); background: transparent; font-size: 38rpx; }.detail-row { min-height: 74rpx; border-bottom: 1rpx solid var(--color-line); color: var(--color-text-secondary); font-size: 25rpx; }.detail-row text:last-child { max-width: 65%; text-align: right; overflow-wrap: anywhere; }
@media (max-width: 340px) { .custom-period { flex-wrap: wrap; }.custom-period picker { flex-basis: 42%; }.apply-button { width: 100%; }.cashflow-card { padding: 22rpx 10rpx; }.cashflow-card text:last-child { font-size: 23rpx; }.row-amount { max-width: 31%; font-size: 24rpx; } }
.ledger-page { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }
