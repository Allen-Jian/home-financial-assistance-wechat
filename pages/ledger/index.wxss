.ledger-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: var(--color-background); }.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.direction-switch { display: flex; gap: 12rpx; margin-top: 34rpx; }.direction-switch button { flex: 1; padding: 0; height: 76rpx; line-height: 76rpx; border-radius: 18rpx; color: var(--color-muted); background: var(--color-tint); font-size: 26rpx; }.direction-switch .active { color: var(--color-on-primary); background: var(--color-primary); }
.amount-box { display: flex; align-items: center; margin-top: 28rpx; padding: 28rpx; border-radius: 28rpx; background: var(--color-surface); }.currency { color: var(--color-primary); font-size: 34rpx; font-weight: 700; }.amount-input { flex: 1; margin-left: 16rpx; color: var(--color-text); font-size: 64rpx; font-weight: 700; }
.field-row { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; padding: 28rpx 24rpx; border-radius: 20rpx; background: var(--color-surface); color: var(--color-text-secondary); font-size: 28rpx; }.picker-value { color: var(--color-primary); }.note { width: 100%; min-height: 160rpx; margin-top: 18rpx; padding: 24rpx; box-sizing: border-box; border-radius: 20rpx; background: var(--color-surface); color: var(--color-text-secondary); font-size: 28rpx; }.attachment { margin-top: 18rpx; color: var(--color-primary); background: var(--color-tint); font-size: 26rpx; }.primary-button { color: var(--color-on-primary); background: var(--color-primary); }.save-button { margin-top: 32rpx; border-radius: 18rpx; }.error { display: block; margin-top: 18rpx; color: var(--color-expense); font-size: 24rpx; }.duplicate-panel { margin-top: 20rpx; padding: 24rpx; border-radius: 20rpx; background: var(--color-warning-surface); }.duplicate-title, .duplicate-detail { display: block; }.duplicate-title { color: var(--color-warning); font-size: 28rpx; font-weight: 700; }.duplicate-detail { margin-top: 8rpx; color: var(--color-warning); font-size: 24rpx; }.duplicate-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }.duplicate-actions button { flex: 1; font-size: 24rpx; }
