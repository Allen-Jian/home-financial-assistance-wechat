.ledger-page { min-height: 100vh; padding: 36rpx 32rpx 64rpx; box-sizing: border-box; background: #f4fbf8; }.page-title text { display: block; color: #123b38; font-size: 40rpx; font-weight: 700; }.page-title .sub { margin-top: 8rpx; color: #78918d; font-size: 24rpx; font-weight: 400; }
.direction-switch { display: flex; gap: 12rpx; margin-top: 34rpx; }.direction-switch button { flex: 1; padding: 0; height: 76rpx; line-height: 76rpx; border-radius: 18rpx; color: #6b817d; background: #e8f3ef; font-size: 26rpx; }.direction-switch .active { color: #fff; background: #127c73; }
.amount-box { display: flex; align-items: center; margin-top: 28rpx; padding: 28rpx; border-radius: 28rpx; background: #fff; }.currency { color: #127c73; font-size: 34rpx; font-weight: 700; }.amount-input { flex: 1; margin-left: 16rpx; color: #123b38; font-size: 64rpx; font-weight: 700; }
.field-row { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; padding: 28rpx 24rpx; border-radius: 20rpx; background: #fff; color: #3d5753; font-size: 28rpx; }.picker-value { color: #127c73; }.note { width: 100%; min-height: 160rpx; margin-top: 18rpx; padding: 24rpx; box-sizing: border-box; border-radius: 20rpx; background: #fff; color: #3d5753; font-size: 28rpx; }.attachment { margin-top: 18rpx; color: #127c73; background: #e8f3ef; font-size: 26rpx; }.primary-button { color: #fff; background: #127c73; }.save-button { margin-top: 32rpx; border-radius: 18rpx; }.error { display: block; margin-top: 18rpx; color: #c54545; font-size: 24rpx; }.duplicate-panel { margin-top: 20rpx; padding: 24rpx; border-radius: 20rpx; background: #fff4d6; }.duplicate-title, .duplicate-detail { display: block; }.duplicate-title { color: #8d5d15; font-size: 28rpx; font-weight: 700; }.duplicate-detail { margin-top: 8rpx; color: #9b671c; font-size: 24rpx; }.duplicate-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }.duplicate-actions button { flex: 1; font-size: 24rpx; }
