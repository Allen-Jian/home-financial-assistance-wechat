.login-page { min-height: 100vh; padding: 74rpx 44rpx 54rpx; align-items: center; background: var(--color-background); text-align: center; }.brand-mark { display: flex; width: 104rpx; height: 104rpx; margin: auto; align-items: center; justify-content: center; border-radius: 34rpx; color: var(--color-on-primary); background: var(--color-primary); box-shadow: 0 14rpx 34rpx var(--shadow-primary); }.brand-mark text { font-size: 52rpx; font-weight: 600; }.title, .subtitle { display: block; }.title { margin-top: 24rpx; color: var(--color-text); font-size: 46rpx; font-weight: 600; }.subtitle { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; }
.wechat-login { display: flex; width: 100%; min-height: 94rpx; margin-top: 48rpx; align-items: center; justify-content: center; gap: 14rpx; border-radius: 24rpx; color: #fff; background: #22a85a; font-size: 28rpx; font-weight: 600; }.wechat-mark { position: relative; width: 44rpx; height: 34rpx; }.wechat-mark view { position: absolute; border: 3rpx solid #fff; border-radius: 50%; }.wechat-mark view:first-child { left: 0; top: 0; width: 28rpx; height: 23rpx; }.wechat-mark view:last-child { right: 0; bottom: 0; width: 24rpx; height: 19rpx; }
.wechat-options, .account-form { margin-top: 16rpx; }.input-field { display: flex; width: 100%; min-height: 94rpx; margin-top: 14rpx; padding: 18rpx 20rpx; align-items: center; gap: 18rpx; border: 2rpx solid var(--color-line); border-radius: 22rpx; background: var(--color-surface); text-align: left; }.input-field > text { flex: none; width: 150rpx; color: var(--color-text-secondary); font-size: 24rpx; }.input-field input { flex: 1; min-width: 0; color: var(--color-text); font-size: 25rpx; }.divider { display: flex; margin: 30rpx 0 0; align-items: center; gap: 16rpx; }.divider view { flex: 1; height: 1rpx; background: var(--color-line); }.divider text { flex: none; color: var(--color-muted); font-size: 22rpx; }.account-form { margin-top: 4rpx; }.account-login { width: 100%; margin-top: 18rpx; }.login-error { text-align: left; }.privacy-copy { display: block; margin-top: 24rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.55; }
@media (max-width: 340px) { .login-page { padding-left: 30rpx; padding-right: 30rpx; }.input-field > text { width: 124rpx; }.subtitle { font-size: 23rpx; } }
