.login-page { min-height: 100vh; padding: 120rpx 48rpx 64rpx; box-sizing: border-box; background: var(--color-background); display: flex; flex-direction: column; align-items: center; }
.brand-mark { width: 112rpx; height: 112rpx; border-radius: 36rpx; background: var(--color-primary); color: var(--color-on-primary); display: flex; align-items: center; justify-content: center; font-size: 64rpx; font-weight: 700; }
.title { margin-top: 32rpx; color: var(--color-text); font-size: 52rpx; font-weight: 700; }
.subtitle { margin-top: 16rpx; color: var(--color-muted); font-size: 28rpx; }
.panel { width: 100%; margin-top: 72rpx; padding: 36rpx; box-sizing: border-box; border-radius: 32rpx; background: var(--color-surface); box-shadow: 0 16rpx 48rpx var(--shadow-primary); }
.input { height: 92rpx; padding: 0 24rpx; margin-bottom: 20rpx; box-sizing: border-box; border: 2rpx solid var(--color-line); border-radius: 18rpx; color: var(--color-text); }
.primary-button { color: var(--color-on-primary); background: var(--color-primary); border-radius: 18rpx; }
.error { display: block; margin-top: 20rpx; color: var(--color-expense); font-size: 24rpx; }
.hint { margin-top: 28rpx; color: var(--color-muted); font-size: 24rpx; text-align: center; }
