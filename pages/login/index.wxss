.login-page { min-height: 100vh; padding: 120rpx 48rpx 64rpx; box-sizing: border-box; background: #f4fbf8; display: flex; flex-direction: column; align-items: center; }
.brand-mark { width: 112rpx; height: 112rpx; border-radius: 36rpx; background: #127c73; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 64rpx; font-weight: 700; }
.title { margin-top: 32rpx; color: #123b38; font-size: 52rpx; font-weight: 700; }
.subtitle { margin-top: 16rpx; color: #6b817d; font-size: 28rpx; }
.panel { width: 100%; margin-top: 72rpx; padding: 36rpx; box-sizing: border-box; border-radius: 32rpx; background: #fff; box-shadow: 0 16rpx 48rpx rgba(18, 124, 115, .08); }
.input { height: 92rpx; padding: 0 24rpx; margin-bottom: 20rpx; box-sizing: border-box; border: 2rpx solid #d9e9e5; border-radius: 18rpx; color: #123b38; }
.primary-button { color: #fff; background: #127c73; border-radius: 18rpx; }
.error { display: block; margin-top: 20rpx; color: #c54545; font-size: 24rpx; }
.hint { margin-top: 28rpx; color: #78918d; font-size: 24rpx; text-align: center; }
