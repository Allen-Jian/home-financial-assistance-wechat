<view class="page login-page">
  <view class="brand-mark">家</view>
  <text class="title">家庭手账</text>
  <text class="subtitle">把每一笔生活，都放在同一个家里</text>
  <view class="panel">
    <input class="input" placeholder="邀请码（可选）" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
    <input class="input" placeholder="新家庭名称" value="{{householdName}}" bindinput="onHouseholdNameInput" />
    <button class="primary-button" loading="{{loading}}" bindtap="submit">微信登录</button>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>
  <text class="hint">首次登录且没有邀请码时，会创建“我的家庭”</text>
</view>
