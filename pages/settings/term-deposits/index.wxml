<page-meta page-style="{{themePageStyle}}" />
<view class="page term-page {{themeClass}}"><view class="page-title"><text>定期存款</text><text class="sub">本金属于总资产，只记录期限与利率</text></view><view class="card deposit-form"><input data-field="name" placeholder="名称" bindinput="onDraftInput"/><input data-field="principalMinor" type="digit" placeholder="本金 NZ$" bindinput="onDraftInput"/><input data-field="annualRateBasisPoints" type="number" placeholder="年利率（基点）" bindinput="onDraftInput"/><picker mode="date" data-field="startedAt" bindchange="onDraftInput"><view class="picker-value">开始日：{{draft.startedAt || '请选择'}}</view></picker><picker mode="date" data-field="maturesAt" bindchange="onDraftInput"><view class="picker-value">到期日：{{draft.maturesAt || '请选择'}}</view></picker><button class="primary-button" bindtap="create">新增定存</button></view><view wx:for="{{deposits}}" wx:key="id" class="deposit-row"><view class="row"><text class="deposit-name">{{item.name}}</text><text class="money-number">{{item.principalDisplay}}</text></view><text class="sub">{{item.startedAt}} 至 {{item.maturesAt}} · {{item.statusLabel}}</text><button wx:if="{{item.status !== 'closed'}}" class="close-button" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="close">关闭定存</button></view><view wx:if="{{!deposits.length && !loading}}" class="empty">还没有定期存款</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
