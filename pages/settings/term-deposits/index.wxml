<view class="page"><view class="page-title"><text>定期存款</text><text class="sub">只记录定存元数据，不自动生成账目</text></view><view class="card"><input data-field="name" placeholder="名称" bindinput="onDraftInput"/><input data-field="principalMinor" type="digit" placeholder="本金 NZ$" bindinput="onDraftInput"/><input data-field="annualRateBasisPoints" type="number" placeholder="年利率（基点）" bindinput="onDraftInput"/><picker mode="date" data-field="startedAt" bindchange="onDraftInput"><view>开始日：{{draft.startedAt || '请选择'}}</view></picker><picker mode="date" data-field="maturesAt" bindchange="onDraftInput"><view>到期日：{{draft.maturesAt || '请选择'}}</view></picker><button class="primary-button" bindtap="create">新增定存</button></view><view wx:for="{{deposits}}" wx:key="id" class="card"><view class="row"><text>{{item.name}}</text><text>NZ$ {{item.principalMinor / 100}}</text></view><text class="sub">{{item.startedAt}} 至 {{item.maturesAt}} · {{item.status === 'closed' ? '已关闭' : item.status === 'matured' ? '已到期' : '存续中'}}</text><button wx:if="{{item.status !== 'closed'}}" size="mini" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="close">关闭定存</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
