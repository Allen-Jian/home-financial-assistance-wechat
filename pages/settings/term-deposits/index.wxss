.term-page { min-height: 100vh; background: var(--color-background); }
.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }
.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; font-weight: 400; }
.deposit-form { margin-top: 28rpx; }
.deposit-form input, .picker-value { min-height: 88rpx; margin-bottom: 16rpx; padding: 0 22rpx; border: 2rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-elevated); color: var(--color-text); line-height: 88rpx; }
.primary-button { margin-top: 6rpx; }
.deposit-row { padding: 26rpx 0; border-bottom: 1rpx solid var(--color-line); }
.row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }
.deposit-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; }
.close-button { min-height: 88rpx; margin: 18rpx 0 0; padding: 0 22rpx; border: 2rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-surface); color: var(--color-expense); font-size: 25rpx; }
.empty { padding: 90rpx 0; color: var(--color-muted); text-align: center; }
.error { display: block; margin-top: 20rpx; color: var(--color-expense); font-size: 25rpx; }
