.assets-page { min-height: 100vh; background: var(--color-background); }
.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }
.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; font-weight: 400; }
.asset-form { margin-top: 28rpx; }
.label { display: block; color: var(--color-text-secondary); font-size: 26rpx; font-weight: 600; }
.amount-field { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding: 0 22rpx; border: 2rpx solid var(--color-line); border-radius: 20rpx; background: var(--color-elevated); color: var(--color-primary); font-size: 32rpx; font-weight: 700; }
.amount-field:focus-within { border-color: var(--color-focus); box-shadow: 0 0 0 6rpx var(--focus-ring); }
.amount-field input { min-width: 0; height: 104rpx; flex: 1; color: var(--color-text); font-size: 40rpx; font-weight: 700; }
.hint { display: block; margin-top: 16rpx; color: var(--color-muted); font-size: 24rpx; }
.primary-button { margin-top: 24rpx; }
.success { margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-success-surface); color: var(--color-income); font-size: 25rpx; }
.empty { padding: 90rpx 0; color: var(--color-muted); text-align: center; }
.error { display: block; margin-top: 20rpx; color: var(--color-expense); font-size: 25rpx; }
