<page-meta page-style="{{themePageStyle}}" />
<view class="page assets-page {{themeClass}}"><view class="page-title"><text>初始资产</text><text class="sub">记录家庭账本启用时的资产余额</text></view><view class="card asset-form" wx:if="{{primary}}"><text class="label">{{primary.name}}</text><view class="amount-field"><text>NZ$</text><input type="digit" value="{{amount}}" placeholder="0.00" bindinput="onAmountInput"/></view><text class="hint">之后的收入与支出会从这个起点更新总资产。</text><button class="primary-button" bindtap="save">保存初始资产</button></view><view wx:if="{{!primary && !loading && !error}}" class="empty">暂时无法找到家庭资产</view><view wx:if="{{saved}}" class="success">已保存</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
