<view class="page"><view class="page-title"><text>初始资产</text><text class="sub">记录家庭资产账户的初始余额</text></view><view class="card" wx:if="{{primary}}"><text class="label">{{primary.name}}</text><input type="digit" value="{{amount}}" placeholder="0.00" bindinput="onAmountInput"/><button class="primary-button" bindtap="save">保存初始资产</button></view><view wx:if="{{saved}}" class="success">已保存</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
