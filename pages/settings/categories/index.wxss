.categories-page { min-height: 100vh; background: var(--color-background); }
.page-title text { display: block; color: var(--color-text); font-size: 40rpx; font-weight: 700; }
.page-title .sub { margin-top: 8rpx; color: var(--color-muted); font-size: 25rpx; font-weight: 400; }
.create-card { margin-top: 28rpx; }
.create-card input, .picker-value { min-height: 88rpx; padding: 0 22rpx; border: 2rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-elevated); color: var(--color-text); line-height: 88rpx; }
.picker-value { margin-top: 16rpx; color: var(--color-text-secondary); }
.primary-button { margin-top: 20rpx; }
.category-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }
.category-copy { min-width: 0; flex: 1; }
.category-copy input { width: 100%; min-height: 88rpx; padding: 0 16rpx; border: 2rpx solid transparent; border-radius: 16rpx; color: var(--color-text); font-size: 29rpx; font-weight: 600; }
.category-copy .sub { display: block; margin: 4rpx 16rpx 0; color: var(--color-muted); font-size: 24rpx; }
.toggle-button { width: 128rpx; min-height: 88rpx; margin: 0; padding: 0 14rpx; border: 2rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-surface); color: var(--color-primary); font-size: 25rpx; }
.empty { padding: 90rpx 0; color: var(--color-muted); text-align: center; }
.error { display: block; margin-top: 20rpx; color: var(--color-expense); font-size: 25rpx; }
