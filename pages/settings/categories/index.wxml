<page-meta page-style="{{themePageStyle}}" />
<view class="page categories-page {{themeClass}}"><view class="page-title"><text>分类管理</text><text class="sub">停用分类不会删除历史账目</text></view><view class="card create-card"><input value="{{name}}" placeholder="分类名称" bindinput="onNameInput"/><picker mode="selector" range="{{directionOptions}}" bindchange="onDirectionChange"><view class="picker-value">类型：{{direction === 'expense' ? '支出' : '收入'}}</view></picker><button class="primary-button" bindtap="create">新增分类</button></view><view wx:for="{{categories}}" wx:key="id" class="category-row"><view class="category-copy"><input value="{{item.name}}" data-id="{{item.id}}" bindblur="rename"/><text class="sub">{{item.direction === 'expense' ? '支出' : '收入'}} · {{item.active === false ? '已停用' : '启用中'}}</text></view><button class="toggle-button" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleActive">{{item.active === false ? '启用' : '停用'}}</button></view><view wx:if="{{!categories.length && !loading}}" class="empty">还没有分类</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
