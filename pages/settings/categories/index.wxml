<view class="page"><view class="page-title"><text>分类管理</text><text class="sub">停用分类不会删除历史账目</text></view><view class="card"><input value="{{name}}" placeholder="分类名称" bindinput="onNameInput"/><picker mode="selector" range="{{directionOptions}}" bindchange="onDirectionChange"><view class="picker-value">{{direction === 'expense' ? '支出' : '收入'}}</view></picker><button class="primary-button" bindtap="create">新增分类</button></view><view wx:for="{{categories}}" wx:key="id" class="card category-row"><view><input value="{{item.name}}" data-id="{{item.id}}" bindblur="rename"/><text class="sub">{{item.direction === 'expense' ? '支出' : '收入'}} · {{item.active === false ? '已停用' : '启用中'}}</text></view><button size="mini" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleActive">{{item.active === false ? '启用' : '停用'}}</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
