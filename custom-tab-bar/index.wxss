.custom-tab-bar {
  --tab-background: #FFFFFF;
  --tab-line: #E5DDD3;
  --tab-text: #66736E;
  --tab-selected: #2F6F64;
  --tab-action: #FF9671;
  --tab-action-text: #24312D;
  position: relative;
  color: var(--tab-text);
  background: var(--tab-background);
}

.custom-tab-bar.theme-dark {
  --tab-background: #18221F;
  --tab-line: #30433D;
  --tab-text: #A5B2AD;
  --tab-selected: #74C6B2;
  --tab-action: #FF9F7D;
  --tab-action-text: #10231E;
}

.tab-bar-inner {
  display: flex;
  height: 112rpx;
  align-items: flex-end;
  border-top: 1rpx solid var(--tab-line);
  box-shadow: 0 -8rpx 24rpx rgba(36, 49, 45, .06);
}

.tab-slot {
  display: flex;
  position: relative;
  flex: 1;
  height: 104rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 14rpx 0 12rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  border-radius: 0;
  color: var(--tab-text);
  background: transparent;
  font-size: 20rpx;
}

.tab-slot.selected { color: var(--tab-selected); font-weight: 600; }
.tab-icon { width: 42rpx; height: 42rpx; }
.action-slot { z-index: 1; color: var(--tab-action-text); }
.action-icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 2rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--tab-action-text);
  background: var(--tab-action);
  box-shadow: 0 10rpx 22rpx rgba(36, 49, 45, .2);
  font-size: 48rpx;
  line-height: 1;
}
.action-slot text { margin-bottom: -2rpx; }
.safe-area { height: env(safe-area-inset-bottom); background: var(--tab-background); }
